;;-*-Lisp-*-
(in-package goal)

;; name: lights.gc
;; name in dgo: lights
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

;; og:preserve-this partial landing (effects leg rung 5, #57): the mercneric pipeline
;; copies *default-lights* into the generic work every frame, and with this file a
;; stub the symbol linked 0. GOAL truthiness passed it through the (if arg1 ...)
;; check in generic-initialize-without-sync (0 is not #f), and quad-copy! read GOAL
;; address 0, crashing the first frame after the drawable.gc guard opened. These two
;; definitions are jak3's lights.gc:61-75 verbatim, field-checked against the landed
;; jakx vu-lights in lights-h.gc (identical layout, including the fade overlays at
;; offsets 28/44). The rest of the file lands with the lights leg.

(define *default-lights* (new 'global 'vu-lights))

(defun vu-lights-default! ((lights vu-lights))
  "Setups up a default [[vu-lights]] instance
   @param! lights
   @returns [[vu-lights]]"
  (set-vector! (-> lights ambient) 0.3 0.3 0.3 1.0)
  (set-vector! (-> lights color 0) 1.0 1.0 1.0 1.0)
  (set-vector! (-> lights color 1) 0.2 0.2 0.2 1.0)
  (set-vector! (-> lights color 2) 0.0 0.0 0.0 1.0)
  (set-vector! (-> lights direction 0) 1.0 0.0 0.0 1.0)
  (set-vector! (-> lights direction 1) 0.0 1.0 0.0 1.0)
  (set-vector! (-> lights direction 2) 0.0 0.0 1.0 1.0)
  lights
  )

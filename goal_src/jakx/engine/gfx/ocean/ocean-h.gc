    (ocean-texture-add-call-done (_type_ dma-buffer) none) ;; 71 ;; jak3 77, shift-inferred
    (draw-ocean-texture (_type_ dma-buffer int) none) ;; 72 ;; jak3 78, shift-inferred
    (ocean-method-73 (_type_ (pointer rgba)) none) ;; 73 ;; jak3 79, shift-inferred
    (ocean-method-74 (_type_ dma-buffer) none) ;; 74 ;; jak3 80, shift-inferred
    (draw-envmap-debug (_type_ dma-buffer) none) ;; 75 ;; jak3 81, shift-inferred
    (ocean-method-76 (_type_ dma-buffer float) int) ;; 76 ;; jak3 82, shift-inferred
    (ocean-method-77 (_type_ dma-buffer sky-upload-data vector4w float) none) ;; 77 ;; jak3 83, shift-inferred
    (ocean-method-78 (_type_ dma-buffer) none) ;; 78 ;; jak3 84, shift-inferred
    (ocean-method-79 (_type_ vector vector vector vector) none) ;; 79 ;; jak3 85, shift-inferred
    (ocean-method-80 (_type_ vector vector vector) none) ;; 80 ;; jak3 86, shift-inferred
    (ocean-method-81 (_type_ dma-buffer) none) ;; 81 ;; jak3 87, shift-inferred
    (ocean-method-82 (_type_ dma-buffer) none) ;; 82 ;; jak3 88, shift-inferred
    (rgba-to-vector! (_type_ vector (pointer int32)) none) ;; 83 ;; jak3 90; asm: pextlb/pextlh/itof unpack
    )
  )


(define *ocean-map* (the-as ocean-map #f))

(define *ocean* (new 'static 'ocean :tex1 #xf6f00000178 :tex1-near #xf6f00000164))

;;-*-Lisp-*-
(in-package goal)

;; name: ocean-h.gc
;; name in dgo: ocean-h
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

(deftype ocean-corner (structure)
  ((bsphere       sphere  :inline)
   (start-corner  vector  :inline)
   (y-scales      vector  :inline)
   (alphas        vector  :inline)
   (colors        uint32  4)
   )
  )


(deftype ocean-wave-info (structure)
  ((frequency   float)
   (amplitude   float)
   (wave-speed  float)
   (angle       float)
   (kx          float)
   (ky          float)
   (w           float)
   (flags       int32)
   )
  )


(deftype ocean-vertex (structure)
  ((pos  vector  :inline)
   (stq  vector  :inline)
   (col  vector  :inline)
   )
  )


(deftype ocean-spheres (structure)
  ((spheres  sphere  36 :inline)
   )
  )


(deftype ocean-colors (structure)
  ((colors  rgba  2548)
   )
  )


(deftype ocean-colors-float (structure)
  ((colors  vector  2548 :inline)
   )
  )


(deftype ocean-mid-mask (structure)
  ((mask   uint8   8)
   (dword  uint64  :overlay-at (-> mask 0))
   )
  :pack-me
  )


(deftype ocean-mid-indices (basic)
  ((data  uint16  36)
   )
  )


(deftype ocean-mid-masks (basic)
  ((data  (inline-array ocean-mid-mask))
   )
  )


(deftype ocean-trans-mask (structure)
  ((mask  uint8  4)
   (word  int32  :overlay-at (-> mask 0))
   )
  :pack-me
  )


(deftype ocean-trans-index (structure)
  ((parent  int16)
   (child   int16)
   )
  :pack-me
  )


(deftype ocean-trans-indices (basic)
  ((data  ocean-trans-index  2304 :inline)
   )
  )


(deftype ocean-near-index (structure)
  ((data  uint16  16)
   )
  )


(deftype ocean-near-indices (basic)
  ((data  (inline-array ocean-near-index))
   )
  )


(deftype ocean-near-colors (structure)
  ((color0  vector  :inline)
   (color1  vector  :inline)
   (color2  vector  :inline)
   (color3  vector  :inline)
   )
  )


(deftype ocean-trans-strip (structure)
  ((verts  uint128  10)
   )
  )


(deftype ocean-trans-strip-array (structure)
  ((data  ocean-trans-strip  4 :inline)
   )
  )


(deftype ocean-wave-data (structure)
  ((data  uint8  1024)
   )
  )


(deftype ocean-wave-frames (structure)
  ((frame  ocean-wave-data  64 :inline)
   )
  )


(deftype ocean-texture-constants (structure)
  ((giftag     qword     :inline)
   (buffers    vector4w  :inline)
   (dests      vector4w  :inline)
   (start      vector    :inline)
   (offsets    vector    :inline)
   (constants  vector    :inline)
   (cam-nrm    vector    :inline)
   )
  )


(deftype ocean-mid-vertex (structure)
  ((stq  vector  :inline)
   (col  vector  :inline)
   (pos  vector  :inline)
   )
  )


(deftype ocean-mid-constants (structure)
  ((hmge-scale      vector        :inline)
   (inv-hmge-scale  vector        :inline)
   (hvdf-offset     vector        :inline)
   (fog             vector        :inline)
   (constants       vector        :inline)
   (constants2      vector        :inline)
   (drw-fan         qword         :inline)
   (env-fan         qword         :inline)
   (drw-adgif       qword         :inline)
   (drw-texture     adgif-shader  :inline)
   (drw-strip-0     qword         :inline)
   (drw-strip-1     qword         :inline)
   (env-adgif       qword         :inline)
   (env-texture     adgif-shader  :inline)
   (env-strip       qword         :inline)
   (env-color       vector        :inline)
   (index-table     vector4w      8 :inline)
   (pos0            vector        :inline)
   (pos1            vector        :inline)
   (pos2            vector        :inline)
   (pos3            vector        :inline)
   )
  )


(deftype ocean-mid-upload (structure)
  ((rot     matrix   :inline)
   (matrix  matrix   :inline)
   (colors  uint128  108)
   (masks   uint128  2)
   )
  )


(deftype ocean-mid-upload2 (structure)
  ((rot     matrix    :inline)
   (matrix  matrix    :inline)
   (count   vector4w  :inline)
   (tex0    vector    :inline)
   (tex1    vector    :inline)
   (tex2    vector    :inline)
   (tex3    vector    :inline)
   (clr0    vector    :inline)
   (clr1    vector    :inline)
   (clr2    vector    :inline)
   (clr3    vector    :inline)
   (verts   uint128   18)
   )
  )


(deftype ocean-mid-work (structure)
  ((env0     vector   :inline)
   (env1     vector   :inline)
   (env2     vector   :inline)
   (hmg0     vector   :inline)
   (hmg1     vector   :inline)
   (hmg2     vector   :inline)
   (indices  uint128  16)
   )
  )


(deftype ocean-near-constants (structure)
  ((hmge-scale      vector        :inline)
   (inv-hmge-scale  vector        :inline)
   (hvdf-offset     vector        :inline)
   (fog             vector        :inline)
   (constants       vector        :inline)
   (constants2      vector        :inline)
   (constants3      vector        :inline)
   (constants4      vector        :inline)
   (constants5      vector        :inline)
   (drw-fan         qword         :inline)
   (drw2-fan        qword         :inline)
   (env-fan         qword         :inline)
   (drw-adgif       qword         :inline)
   (drw-texture     adgif-shader  :inline)
   (drw-strip       qword         :inline)
   (env-adgif       qword         :inline)
   (env-texture     adgif-shader  :inline)
   (env-strip       qword         :inline)
   (env-color       vector        :inline)
   (drw2-adgif      qword         :inline)
   (drw2-tex0       qword         :inline)
   (drw2-frame      qword         :inline)
   (drw2-strip      qword         :inline)
   (drw3-adgif      qword         :inline)
   (drw3-frame      qword         :inline)
   (index-table     vector4w      4 :inline)
   )
  )


(deftype ocean-near-upload (structure)
  ((rot           matrix             :inline)
   (matrix        matrix             :inline)
   (masks         uint128            2)
   (start-height  vector4w           :inline)
   (start-st      vector             :inline)
   (near-colors   ocean-near-colors  :inline)
   )
  )


(deftype ocean-near-vertex (structure)
  ((stq  vector  :inline)
   (clr  vector  :inline)
   (pos  vector  :inline)
   )
  )


(deftype ocean-near-work (structure)
  ((verts-ptr  vector   :inline)
   (indices    uint128  16)
   )
  )


(deftype ocean-height-array (structure)
  ((data  float  1024)
   )
  )


(deftype ocean-map (structure)
  ((start-corner         vector  :inline)
   (far-color            vector  :inline)
   (ocean-colors         ocean-colors)
   (ocean-mid-indices    ocean-mid-indices)
   (ocean-trans-indices  ocean-trans-indices)
   (ocean-near-indices   ocean-near-indices)
   (ocean-mid-masks      ocean-mid-masks)
   )
  (:methods
    (set-height! (_type_ float) none) ;; 9
    (get-base-height (_type_) float) ;; 10
    )
  )


(deftype ocean (ocean-map)
  ((off                 symbol)
   (near-off            symbol)
   (far-on              symbol)
   (all-on              symbol)
   (ocean-facing        uint32)
   (mid-mask-ptrs       pointer           36)
   (mid-camera-masks    uint64            36)
   (trans-mask-ptrs     pointer           64)
   (trans-camera-masks  ocean-trans-mask  16)
   (trans-temp-masks    uint32            16)
   (haze-lights         haze-lights       :inline)
   (near-mask-indices   uint16            16)
   (mid-minx            uint8)
   (mid-maxx            uint8)
   (mid-minz            uint8)
   (mid-maxz            uint8)
   (near-minx           uint8)
   (near-maxx           uint8)
   (near-minz           uint8)
   (near-maxz           uint8)
   (temp-minx           uint8)
   (temp-maxx           uint8)
   (temp-minz           uint8)
   (temp-maxz           uint8)
   (tex1                uint64)
   (tex1-near           uint64)
   (wait-to-vu0         uint32)
   )
  (:methods
    (get-height (_type_ vector symbol) float) ;; 11
    (draw! (_type_) none) ;; 12
    (update-map (_type_ viewport) none) ;; 13 ;; jakx adds the viewport arg, (l.wu (+ a1 176)) = math-camera
    (add-colors! (_type_ vector ocean-vertex) none) ;; 14 ;; jak3 17; asm: 0.1 y-bump + haze-lights dots
    (init-buffer! (_type_ dma-buffer) none) ;; 15 ;; jak3 19, inferred from the sequential drop map; not in the four core objects
    (end-buffer! (_type_ dma-buffer) none) ;; 16 ;; jak3 20; asm: gs-set texa ta1 #x80
    (ocean-near-add-call (_type_ dma-buffer int) none) ;; 17 ;; jak3 22; vif1 stmod
    (ocean-near-add-call-flush (_type_ dma-buffer int) none) ;; 18 ;; jak3 23; vif1 flusha
    (ocean-near-setup-constants (_type_ ocean-near-constants viewport) none) ;; 19 ;; jak3 24 + viewport
    (ocean-near-add-constants (_type_ dma-buffer viewport) none) ;; 20 ;; jak3 25 + viewport (forwarded uncopied to 19)
    (ocean-near-add-matrices (_type_ dma-buffer vector viewport) none) ;; 21 ;; jak3 27 + viewport; jak3 26 add-heights dropped
    (ocean-near-add-upload (_type_ dma-buffer uint uint viewport) none) ;; 22 ;; jak3 28 + viewport
    (draw-ocean-near (_type_ dma-buffer viewport) none) ;; 23 ;; jak3 29 + viewport
    (ocean-trans-camera-masks-bit? (_type_ uint uint) symbol) ;; 24 ;; jak3 30
    (ocean-trans-mask-ptrs-bit? (_type_ int int) symbol) ;; 25 ;; jak3 31
    (ocean-trans-mask-ptrs-set! (_type_ uint uint) symbol) ;; 26 ;; jak3 32
    (ocean-trans-add-upload-table (_type_ dma-buffer uint uint int int symbol viewport) none) ;; 27 ;; jak3 33 + viewport
    (ocean-trans-add-upload-strip (_type_ dma-buffer uint uint int int int viewport) none) ;; 28 ;; jak3 34 + viewport
    (ocean-transition-check (_type_ ocean-trans-mask int int vector) none) ;; 29 ;; jak3 35
    (ocean-make-trans-camera-masks (_type_ uint uint uint uint viewport) none) ;; 30 ;; jak3 36 + viewport
    (ocean-trans-add-upload (_type_ dma-buffer uint uint viewport) none) ;; 31 ;; jak3 37 + viewport
    (draw-ocean-transition-seams (_type_ dma-buffer viewport) none) ;; 32 ;; jak3 38 + viewport
    (ocean-trans-add-constants (_type_ dma-buffer) none) ;; 33 ;; jak3 39
    (draw-ocean-transition (_type_ dma-buffer viewport) none) ;; 34 ;; jak3 40 + viewport
    (ocean-mid-add-call (_type_ dma-buffer int) none) ;; 35 ;; jak3 41
    (ocean-mid-add-call-flush (_type_ dma-buffer uint) none) ;; 36 ;; jak3 42
    (ocean-matrix*! (_type_ matrix matrix matrix) matrix) ;; 37 ;; jak3 43
    (ocean-vector-matrix*! (_type_ vector vector matrix) vector) ;; 38 ;; jak3 44
    (ocean-mid-add-matrices (_type_ dma-buffer vector viewport) none) ;; 39 ;; jak3 45 + viewport
    (ocean-mid-check (_type_ pointer int int vector viewport) symbol) ;; 40 ;; jak3 46 + viewport
    (ocean-mid-setup-constants (_type_ ocean-mid-constants viewport) none) ;; 41 ;; jak3 47 + viewport
    (ocean-mid-add-constants (_type_ dma-buffer viewport) none) ;; 42 ;; jak3 48 + viewport (forwarded uncopied to 41)
    (ocean-mid-camera-masks-bit? (_type_ uint uint) symbol) ;; 43 ;; jak3 49
    (ocean-mid-mask-ptrs-bit? (_type_ uint uint) symbol) ;; 44 ;; jak3 50
    (ocean-mid-camera-masks-set! (_type_ uint uint) symbol) ;; 45 ;; jak3 51
    (ocean-mid-add-upload (_type_ dma-buffer int int int int float viewport) none) ;; 46 ;; jak3 52 + viewport
    (ocean-mid-add-upload-table (_type_ dma-buffer uint uint (pointer float) int symbol viewport) none) ;; 47 ;; jak3 53 + viewport
    (ocean-mid-add-upload-top (_type_ dma-buffer uint uint viewport) none) ;; 48 ;; jak3 54 + viewport
    (ocean-mid-add-upload-middle (_type_ dma-buffer uint uint viewport) none) ;; 49 ;; jak3 55 + viewport
    (ocean-mid-add-upload-bottom (_type_ dma-buffer uint uint viewport) none) ;; 50 ;; jak3 56 + viewport
    (ocean-seams-add-constants (_type_ dma-buffer) none) ;; 51 ;; jak3 57
    (draw-ocean-mid-seams (_type_ dma-buffer viewport) none) ;; 52 ;; jak3 58 + viewport
    (draw-ocean-mid (_type_ dma-buffer viewport) none) ;; 53 ;; jak3 59 + viewport
    (ocean-method-54 (_type_ dma-buffer) none) ;; 54 ;; jak3 60 ocean-method-60
    (ocean-method-55 (_type_ dma-buffer) none) ;; 55 ;; jak3 61
    (ocean-method-56 (_type_ dma-buffer) none) ;; 56 ;; jak3 62
    (ocean-method-57 (_type_ dma-buffer) none) ;; 57 ;; jak3 63
    (ocean-method-58 (_type_ dma-buffer) none) ;; 58 ;; jak3 64
    (ocean-method-59 (_type_ dma-buffer) none) ;; 59 ;; jak3 65
    (ocean-method-60 (_type_ dma-buffer) none) ;; 60 ;; jak3 66
    (ocean-method-61 (_type_ dma-buffer) none) ;; 61 ;; jak3 67
    (render-ocean-far (_type_ dma-buffer viewport) none) ;; 62 ;; jak3 68
    (draw-ocean-far (_type_ dma-buffer viewport) none) ;; 63 ;; jak3 69 + viewport
    (ocean-texture-setup-constants (_type_ ocean-texture-constants) none) ;; 64 ;; jak3 70, shift-inferred (ocean-texture.o not yet decompiled)
    (ocean-texture-add-constants (_type_ dma-buffer) none) ;; 65 ;; jak3 71, shift-inferred
    (ocean-texture-add-envmap (_type_ dma-buffer) none) ;; 66 ;; jak3 72, shift-inferred
    (ocean-texture-add-verts (_type_ dma-buffer int) none) ;; 67 ;; jak3 73, shift-inferred
    (ocean-texture-add-verts-last (_type_ dma-buffer int int) none) ;; 68 ;; jak3 74, shift-inferred
    (ocean-texture-add-call-start (_type_ dma-buffer) none) ;; 69 ;; jak3 75, shift-inferred

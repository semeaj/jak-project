;; definition for method 9 of type viewport-array
;; WARN: Return type mismatch int vs none.
(defmethod viewport-array-method-9 ((this viewport-array) (arg0 viewport))
  (set! (-> this mode) (the-as uint arg0))
  (let ((v1-0 arg0))
    (cond
      ((zero? v1-0)
       (set! (-> this num-viewports) (the-as uint 1))
       (countdown (s5-0 3)
         (set! (-> this data s5-0 index) s5-0)
         (viewport-method-12 (-> this data s5-0))
         )
       )
      ((= v1-0 1)
       (set! (-> this num-viewports) (the-as uint 2))
       (countdown (s5-1 3)
         (set! (-> this data s5-1 index) s5-1)
         (viewport-method-13 (-> this data s5-1))
         )
       )
      ((= v1-0 2)
       (set! (-> this num-viewports) (the-as uint 2))
       (countdown (s5-2 3)
         (set! (-> this data s5-2 index) s5-2)
         (viewport-method-14 (-> this data s5-2))
         )
       )
      )
    )
  (set! *view-count* (the-as int (-> this num-viewports)))
  (if (nonzero? shadow-make-invert-buf)
      (shadow-make-invert-buf)
      )
  (if (nonzero? init-warp)
      (init-warp)
      )
  (if (nonzero? init-hflip-zbuf)
      (init-hflip-zbuf)
      )
  0
  (none)
  )


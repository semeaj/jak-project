;; WARN: Check prologue - tricky store of a0
;; INFO: Used lq/sq
;; WARN: Return type mismatch int vs none.
(defmethod viewport-method-15 ((this viewport))
  (rlet ((vf0 :class vf)
         (vf4 :class vf)
         (vf5 :class vf)
         (vf6 :class vf)
         )
    (init-vf0-vector)
    (let* ((sv-96 this)
           (sv-112 (-> sv-96 math-camera))
           (sv-128 (-> sv-112 camera-rot))
           (s0-0 (-> sv-96 prev-inv-camera-rot))
           (s1-0 (new 'stack-no-clear 'matrix))
           (s2-0 (new 'static 'vector :data (new 'static 'array float 4 0.0 0.0 172032.0 1.0)))
           (s3-0 (new 'static 'vector :data (new 'static 'array float 4 0.0 0.0 -172032.0 1.0)))
           (gp-0 (-> sv-96 motion-vector))
           (s4-0 (new 'stack-no-clear 'vector))
           (s5-0 (new 'static 'vector :data (new 'static 'array float 4 524288.0 524288.0 524288.0 1.0)))
           )
      (if (not (paused?))
          (mem-copy!
            (the-as pointer (-> sv-96 prev-inv-camera-rot))
            (the-as pointer (-> sv-112 prev-inv-camera-rot))
            64
            )
          )
      (matrix*! s1-0 s0-0 sv-128)
      (vector-matrix*! gp-0 s2-0 s1-0)
      (vector-! gp-0 gp-0 s2-0)
      (vector-matrix*! s4-0 s3-0 s1-0)
      (vector-! s4-0 s4-0 s3-0)
      (if (< (vector-length gp-0) (vector-length s4-0))
          (set! (-> gp-0 quad) (-> s4-0 quad))
          )
      (set! (-> gp-0 z) (/ (-> gp-0 z) (* -1638.4 (-> *display* dog-ratio))))
      (let ((a1-4 gp-0))
        (let ((v1-19 gp-0)
              (a0-10 s5-0)
              )
          (.lvf vf4 (&-> v1-19 quad))
          (.lvf vf5 (&-> a0-10 quad))
          )
        (.mov.vf.w vf6 vf0)
        (.add.vf.xyz vf6 vf4 vf5)
        (.svf (&-> a1-4 quad) vf6)
        )
      (vector-! gp-0 gp-0 s5-0)
      )
    0
    (none)
    )
  )


;;-*-Lisp-*-
(in-package goal)

;; name: background.gc
;; name in dgo: background
;; dgos: ENGINE, GAME

;; og:preserve-this landing notes: the finish-* family is DORMANT until the per-frame
;; draw hook calls land (main.gc real-main-draw-hook) and the tree draw objects
;; (tfrag.o / tfrag-methods.o / tie.o / shrub.o) populate *background-work*, so the
;; unlanded draw-drawable-tree-* callees are safe unguarded for now. jakx deltas vs
;; jak3: per-view math camera getters, the shared-tree families in background-work,
;; and per-view matrix selects in finish-tie.
(define-extern *instance-tie-work* instance-tie-work) ;; home tie-work.gc (compiles later)
(define-extern *prototype-tie-work* prototype-tie-work) ;; home tie-work.gc (compiles later)
(define-extern *instance-shrub-work* instance-shrub-work) ;; home shrub-work.gc (compiles later)
(define-extern *draw-index* int)
;; og:preserve-this runtime-link externs: the tree draw generators live in the
;; unlanded tfrag.o / tie.o / shrub.o; the finishers that call them stay dormant
;; until the per-frame draw hook lands, so unguarded calls are safe for now
(define-extern draw-drawable-tree-instance-shrub (function drawable-tree-instance-shrub level none))
(define-extern draw-drawable-tree-instance-tie (function drawable-tree-instance-tie level none))
(define-extern draw-drawable-tree-tfrag (function drawable-tree-tfrag none))
(define-extern draw-drawable-tree-tfrag-trans (function drawable-tree-tfrag none))
(define-extern draw-drawable-tree-tfrag-water (function drawable-tree-tfrag none))
(define-extern tie-scissor-make-perspective-matrix (function matrix matrix none))
(define-extern level-update-wind (function wind-work none)) ;; home wind.gc, not landed
(define-extern tfrag-vu1-init-buffers (function none)) ;; home tfrag.gc, not landed
(define-extern *wind-work* wind-work) ;; home wind-work.gc (compiles later)

;; DECOMP BEGINS

;; definition for symbol *background-work*, type background-work
(define *background-work* (new 'global 'background-work))

;; definition for symbol background-vu0-block, type vu-function
(define background-vu0-block (new 'static 'vu-function :length 59 :qlength 30))

;; definition for function background-upload-vu0
;; WARN: Return type mismatch int vs none.
(defun background-upload-vu0 ()
  ;; og:preserve-this jak3-parity: VU0 upload not needed on PC (believed unused)
  ;; (upload-vu0-program background-vu0-block (&-> *background-work* wait-to-vu0))
  0
  (none)
  )

;; definition for function init-background
;; WARN: Return type mismatch int vs none.
(defun init-background ()
  (dotimes (v1-0 8)
    (set! (-> *background-work* tfrag-trees v1-0) #f)
    (set! (-> *background-work* tfrag-trans-trees v1-0) #f)
    (set! (-> *background-work* tfrag-water-trees v1-0) #f)
    (set! (-> *background-work* tfrag-shared-trees v1-0) #f)
    (set! (-> *background-work* tfrag-trans-shared-trees v1-0) #f)
    (set! (-> *background-work* tfrag-water-shared-trees v1-0) #f)
    )
  (set! (-> *background-work* tfrag-tree-count) 0)
  (set! (-> *background-work* tfrag-trans-tree-count) 0)
  (set! (-> *background-work* tfrag-water-tree-count) 0)
  (set! (-> *background-work* tfrag-shared-tree-count) 0)
  (set! (-> *background-work* tfrag-trans-shared-tree-count) 0)
  (set! (-> *background-work* tfrag-water-shared-tree-count) 0)
  (set! (-> *background-work* shrub-tree-count) 0)
  (set! (-> *background-work* tie-tree-count) 0)
  (set! (-> *background-work* wait-to-vu0) (the-as uint 0))
  0
  (none)
  )

;; definition for function upload-vis-bits
;; og:preserve-this hand port of jak3's PC adaptation (the jakx decomp fails CFG on
;; the software-pipelined loop; the body matches jak3's modulo scheduling)
(defun upload-vis-bits ((arg0 level) (arg1 level) (arg2 bsp-header))
  "Upload vis data to the scratchpad."
  (let ((v1-2 (/ (+ (-> arg2 visible-list-length) 15) 16)))
    (let ((a0-1 (-> arg0 vis-bits))
          (a1-1 (the-as (pointer uinteger) (-> arg2 all-visible-list)))
          ;; (a2-2 (the-as (pointer uint128) (+ #x3800 #x70000000)))
          (a2-2 (scratchpad-ptr uint128 :offset #x3800))
          )
      (b! (not *artist-flip-visible*) cfg-5 :delay (nop!))
      (nop!)
      (nop!)
      (label cfg-2)
      (let ((a3-2 (-> (the-as (pointer uint128) a0-1))))
        (&+! a0-1 16)
        (let ((t0-0 (-> (the-as (pointer uint128) a1-1) 0)))
          (set! a1-1 (&-> (the-as (pointer uint8) a1-1) 16))
          (nop!)
          (nop!)
          (let ((a3-3 (logxor a3-2 (the-as uint t0-0))))
            (+! v1-2 -1)
            (set! (-> a2-2 0) a3-3)
            )
          )
        )
      (set! a2-2 (&-> a2-2 1))
      (b! (> v1-2 0) cfg-2 :delay (nop!))
      0
      (b! #t cfg-8 :delay (nop!))
      (nop!)
      (label cfg-5)
      (nop!)
      (nop!)
      (label cfg-6)
      (let ((a1-2 (-> (the-as (pointer uint128) a0-1))))
        (&+! a0-1 16)
        (nop!)
        (+! v1-2 -1)
        (set! (-> a2-2 0) a1-2)
        )
      (set! a2-2 (&-> a2-2 1))
      )
    (b! (> v1-2 0) cfg-6 :delay (nop!))
    )
  0
  (label cfg-8)
  (none)
  )

;; definition for function set-background-regs!

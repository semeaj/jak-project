(defun set-background-regs! ((arg0 level))
  (none)
  )

;; definition for function set-tie-guard-planes!
;; INFO: Used lq/sq
;; WARN: Return type mismatch plane vs none.
(defun set-tie-guard-planes! ((arg0 level))
  (let ((v1-0 (view-get-active-math-camera)))
    (cond
      ((logtest? (-> arg0 info level-flags) (level-flags use-camera-other))
       (set! (-> *instance-tie-work* guard-plane 0 quad) (-> v1-0 guard-plane-other 0 quad))
       (set! (-> *instance-tie-work* guard-plane 1 quad) (-> v1-0 guard-plane-other 1 quad))
       (set! (-> *instance-tie-work* guard-plane 2 quad) (-> v1-0 guard-plane-other 2 quad))
       (set! (-> *instance-tie-work* guard-plane 3 quad) (-> v1-0 guard-plane-other 3 quad))
       )
      (else
        (set! (-> *instance-tie-work* guard-plane 0 quad) (-> v1-0 guard-plane 0 quad))
        (set! (-> *instance-tie-work* guard-plane 1 quad) (-> v1-0 guard-plane 1 quad))
        (set! (-> *instance-tie-work* guard-plane 2 quad) (-> v1-0 guard-plane 2 quad))
        (set! (-> *instance-tie-work* guard-plane 3 quad) (-> v1-0 guard-plane 3 quad))
        )
      )
    )
  (none)
  )


;; definition for function set-subdivide-settings!
(defun set-subdivide-settings! ((arg0 level))
  (let ((a1-0 (view-get-active-math-camera)))
    (if *artist-use-menu-subdiv*
        (update-subdivide-settings! *subdivide-settings* a1-0 19)

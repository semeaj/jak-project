;; definition for function finish-shrub
;; WARN: Return type mismatch int vs none.
(defun finish-shrub ()
  (when (nonzero? (-> *background-work* shrub-tree-count))
    (when *debug-segment*
      'shrubbery
      (let ((gp-0 (-> *display* frames (-> *display* on-screen) profile-array data 0))
            (v1-11 'shrubbery)
            (s5-0 *profile-shrubbery-color*)
            )
        (when (and *dproc* *debug-segment*)
          (let ((s4-0 (-> gp-0 data (-> gp-0 count))))
            (let ((s3-0 (-> gp-0 base-time)))
              (set! (-> s4-0 name) v1-11)
              (set! (-> s4-0 start-time) (the-as int (- (timer-count (the-as timer-bank #x10000800)) (the-as uint s3-0))))
              )
            (set! (-> s4-0 depth) (the-as uint (-> gp-0 depth)))
            (set! (-> s4-0 color) s5-0)
            (set! (-> gp-0 segment (-> gp-0 depth)) s4-0)
            )
          (set! (-> gp-0 count) (min 2099 (+ (-> gp-0 count) 1)))
          (+! (-> gp-0 depth) 1)
          (set! (-> gp-0 max-depth) (max (-> gp-0 max-depth) (-> gp-0 depth)))
          )
        )
      0
      )
    (dotimes (gp-1 (-> *background-work* shrub-tree-count))
      (set! *draw-index* (-> *background-work* shrub-levels gp-1 draw-index))
      (flush-cache 0)
      (let ((s5-1 (-> *background-work* shrub-trees gp-1))
            (s4-1 (-> *background-work* shrub-levels gp-1))
            )
        (if (nonzero? (-> s5-1 colors-added))
            (time-of-day-interp-colors
              (-> *instance-shrub-work* colors)
              (the-as uint (-> s5-1 colors-added))
              (-> s4-1 mood-context)
              )
            )
        (set-background-regs! s4-1)
        (set-shrub-guard-planes! s4-1)
        (draw-drawable-tree-instance-shrub s5-1 s4-1)
        )
      )
    (when *debug-segment*
      (let ((gp-2 (-> *display* frames (-> *display* on-screen) profile-array data 0)))
        (when (and *dproc* *debug-segment*)
          (let* ((v1-52 (+ (-> gp-2 depth) -1))
                 (s5-2 (-> gp-2 segment v1-52))
                 (s4-2 (-> gp-2 base-time))
                 )
            (when (>= v1-52 0)
              (set! (-> s5-2 end-time) (the-as int (- (timer-count (the-as timer-bank #x10000800)) (the-as uint s4-2))))
              (+! (-> gp-2 depth) -1)
              )
            )
          )
        )
      0
      )
    )
  (let ((a0-23 (-> *display* frames (-> *display* on-screen) global-buf)))
    (when (< (-> a0-23 real-buffer-end) (the-as int (-> a0-23 base)))
      (break!)
      0
      )
    )
  0
  (none)
  )

;; definition for function finish-tfrag
;; WARN: Return type mismatch int vs none.
(defun finish-tfrag ()
  (let ((sv-16 (the-as symbol #f))
        (sv-20 (-> *viewport-array* current-viewport-index))
        (sv-24 (the-as time-of-day-palette #f))
        )
    (dotimes (gp-0 (-> *level* length))
      (let ((s5-0 (-> *level* level gp-0)))
        (when (= (-> s5-0 status) 'active)
          (when *debug-segment*
            'tfrag
            (let ((s4-0 (-> *display* frames (-> *display* on-screen) profile-array data 0))
                  (v1-15 'tfrag)
                  (s3-0 *profile-tfrag-color*)
                  )
              (when (and *dproc* *debug-segment*)
                (let ((s2-0 (-> s4-0 data (-> s4-0 count))))
                  (let ((s1-0 (-> s4-0 base-time)))
                    (set! (-> s2-0 name) v1-15)
                    (set! (-> s2-0 start-time) (the-as int (- (timer-count (the-as timer-bank #x10000800)) (the-as uint s1-0))))
                    )
                  (set! (-> s2-0 depth) (the-as uint (-> s4-0 depth)))
                  (set! (-> s2-0 color) s3-0)
                  (set! (-> s4-0 segment (-> s4-0 depth)) s2-0)
                  )
                (set! (-> s4-0 count) (min 2099 (+ (-> s4-0 count) 1)))
                (+! (-> s4-0 depth) 1)
                (set! (-> s4-0 max-depth) (max (-> s4-0 max-depth) (-> s4-0 depth)))
                )
              )
            0
            )
          (set! *draw-index* (-> s5-0 draw-index))
          (set! (-> *tfrag-work* min-dist z) 4095996000.0)
          (set! (-> *level* draw-level *draw-index* tfrag-last-calls 2) (the-as uint 0))
          (set! (-> *level* draw-level *draw-index* tfrag-last-calls 3) (the-as uint 0))
          (dotimes (s4-1 (-> *background-work* tfrag-tree-count))
            (let ((s3-1 (-> *background-work* tfrag-trees s4-1)))
              (when (= s5-0 (-> *background-work* tfrag-levels s4-1))
                (when s3-1
                  (let ((a2-0 (-> s5-0 bsp))
                        (s2-1 (-> s3-1 time-of-day-pal))
                        )
                    sv-20
                    (upload-vis-bits s5-0 (the-as level sv-16) a2-0)
                    (set-subdivide-settings! s5-0)
                    (when (not (or (zero? s2-1) (= sv-24 s2-1)))
                      (flush-cache 0)
                      (time-of-day-interp-colors-scratch (the-as (pointer rgba) (+ 6144 #x70000000)) s2-1 (-> s5-0 mood-context))
                      (set! sv-24 s2-1)
                      )
                    )
                  (set-background-regs! s5-0)
                  (set! (-> *tfrag-work* texture-dists) (the-as uint (-> s5-0 bsp tfrag-closest)))
                  (draw-drawable-tree-tfrag s3-1)
                  )
                )
              )
            )
          (when (or (= s5-0 (-> *level* wide-level 0)) (= s5-0 (-> *level* wide-level 1)))
            (dotimes (s4-2 (-> *background-work* tfrag-shared-tree-count))
              (let ((s3-2 (-> *background-work* tfrag-shared-levels s4-2))
                    (s2-2 (the-as object (-> *background-work* tfrag-shared-trees s4-2)))
                    )
                (when (and (the-as drawable-tree-tfrag-shared s2-2) (= (-> s5-0 index) (-> (the-as (pointer uint16) s2-2) 0)))
                  (let ((a2-2 (-> s3-2 bsp))
                        (s1-1 (-> (the-as drawable-tree-tfrag-shared s2-2) time-of-day-pal))
                        )
                    sv-20
                    (upload-vis-bits s3-2 (the-as level sv-16) a2-2)
                    (set-subdivide-settings! s3-2)
                    (when (not (or (zero? s1-1) (= sv-24 s1-1)))
                      (flush-cache 0)
                      (time-of-day-interp-colors-scratch (the-as (pointer rgba) (+ 6144 #x70000000)) s1-1 (-> s3-2 mood-context))
                      (set! sv-24 s1-1)
                      )
                    )
                  (set-background-regs! s3-2)
                  (set! (-> *tfrag-work* texture-dists) (the-as uint (-> s3-2 bsp tfrag-closest)))
                  (draw-drawable-tree-tfrag (the-as drawable-tree-tfrag-shared s2-2))
                  )
                )
              )
            )
          (set! (-> *level* draw-level *draw-index* closest-object 0) (-> *tfrag-work* min-dist z))
          (when *debug-segment*
            (let ((s5-1 (-> *display* frames (-> *display* on-screen) profile-array data 0)))
              (when (and *dproc* *debug-segment*)
                (let* ((v1-97 (+ (-> s5-1 depth) -1))
                       (s4-3 (-> s5-1 segment v1-97))
                       (s3-3 (-> s5-1 base-time))
                       )
                  (when (>= v1-97 0)
                    (set! (-> s4-3 end-time) (the-as int (- (timer-count (the-as timer-bank #x10000800)) (the-as uint s3-3))))
                    (+! (-> s5-1 depth) -1)
                    )
                  )
                )
              )
            0
            )
          )
        )
      )
    )
  (let ((a0-42 (-> *display* frames (-> *display* on-screen) global-buf)))
    (when (< (-> a0-42 real-buffer-end) (the-as int (-> a0-42 base)))
      (break!)
      0
      )
    )
  0
  (none)
  )


;;-*-Lisp-*-
(in-package goal)

;; name: blit-displays-h.gc
;; name in dgo: blit-displays-h
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

(deftype blit-displays-work (structure)
  ((adgif-tmpl                dma-gif-packet  :inline)
   (sprite-tmpl               dma-gif-packet  :inline)
   (contrast-tmpl             dma-gif-packet  :inline)
   (sprite-slow-tmpl          dma-gif-packet  :inline)
   (screen-tmpl               dma-gif-packet  :inline)
   (blur-tmpl                 dma-gif-packet  :inline)
   (blur-tmpl2                dma-gif-packet  :inline)
   (line-tmpl                 dma-gif-packet  :inline)
   (scan-tmpl                 dma-gif-packet  :inline)
   (color                     vector4w        :inline)
   (line-color                uint64)
   (scan-colors               vector4w        15 :inline)
   (vu1-enable-user-menu      uint64)
   (texture-enable-user-menu  uint32)
   (horizontal-flip-flag      symbol)
   (scan-alpha                float)
   (scanline                  uint32)
   (progress-interp           float)
   (progress-interp-dest      float)
   (progress-interp-speed     float)
   )
  (:methods
    ;; og:preserve-this names for 9-17 follow the jak3-parity hypothesis (arities are
    ;; read-derived from the asm); the 21-25 viewport family keeps numbered names
    ;; until the bodies identify them; jakx inserts the flip-flag pair at 19/20
    (blit-standard (_type_ dma-buffer int int int) none)
    (blit-slow-time (_type_ dma-buffer int int int) none)
    (draw-sprite-color (_type_ dma-buffer int) none)
    (draw-letterbox (_type_ dma-buffer float int float int) none)
    (draw-antialias (_type_ dma-buffer (pointer float) int) none)
    (draw-color-filter (_type_ dma-buffer vector) none)
    (fx-to-raster-flipped (_type_ dma-buffer int) none)
    (draw-brightness-and-contrast (_type_ dma-buffer float float int) none)
    (do-blit-displays (_type_ vector int object symbol int) none)
    (blit-displays-work-method-18 () none)
    (get-horizontal-flip-flag (_type_) symbol)
    (set-horizontal-flip-flag (_type_ symbol) symbol)
    (blit-displays-work-method-21 (_type_ dma-buffer viewport int) none)
    (blit-displays-work-method-22 (_type_ dma-buffer viewport int float int) none)
    (blit-displays-work-method-23 (_type_ dma-buffer viewport int) none)
    (blit-displays-work-method-24 (_type_ dma-buffer viewport int int) none)
    (blit-displays-work-method-25 (_type_ dma-buffer viewport int) none)
    (blit-displays-work-method-26 (_type_ dma-buffer) none)
    )
  )


(defmethod get-horizontal-flip-flag ((this blit-displays-work))
  (-> this horizontal-flip-flag)
  )

(defmethod set-horizontal-flip-flag ((this blit-displays-work) (arg0 symbol))
  (set! (-> this horizontal-flip-flag) arg0)
  arg0
  )

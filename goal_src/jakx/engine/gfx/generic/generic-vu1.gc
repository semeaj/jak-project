;;-*-Lisp-*-
(in-package goal)

;; name: generic-vu1.gc
;; name in dgo: generic-vu1
;; dgos: ENGINE, GAME

;; og:preserve-this landed at the effects leg rung 6 (#57), machine-faithful to the
;; jakx decomp in object order. jakx deltas vs jak3, each proven from the ir2 arg
;; registers: the constants pair reads the math camera through the viewport (+176)
;; instead of *math-camera*, and the init-buf chain takes a viewport and a gs-test:
;; the GS direct block grows from jak3's one A+D register (zbuf-1) to four (zbuf-1,
;; frame-1 and scissor-1 from the viewport, test-1 from the argument), 96 bytes with
;; header against jak3's 32. Generic2's PC parser accepts both shapes. The shrub pair
;; keeps jak3's 4-arg shape unchanged.

(define-extern fx-copy-buf (function dma-buffer viewport none)) ;; home warp.gc, not landed

;; DECOMP BEGINS

;; og:preserve-this PC stub, jak3 parity: the VU1 microcode sizes stay commented so
;; the block is empty on PC and dma-buffer-add-vu-function emits only a degenerate
;; ref tag, which is exactly what Generic2's parser expects ahead of the GS block.
(define generic-vu1-block (new 'static 'vu-function #|:length #x6de :qlength #x36f|#))

(defun generic-setup-constants ((arg0 generic-constants) (arg1 viewport))
  ;; og:preserve-this jakx delta: the camera comes from the viewport, not *math-camera*
  (let ((v1-0 (-> arg1 math-camera)))
    (set-vector! (-> arg0 fog) (-> v1-0 pfog0) (-> v1-0 fog-min) (-> v1-0 fog-max) 3072.0)
    (set! (-> arg0 adgif tag) (new 'static 'gif-tag64 :nloop #x7 :nreg #x1))
    (set! (-> arg0 adgif regs) (new 'static 'gif-tag-regs :regs0 (gif-reg-id a+d)))
    (set! (-> arg0 hvdf-offset quad) (-> v1-0 hvdf-off quad))
    (set! (-> arg0 hmge-scale quad) (-> v1-0 hmge-scale quad))
    (set! (-> arg0 invh-scale quad) (-> v1-0 inv-hmge-scale quad))
    (set! (-> arg0 guard quad) (-> v1-0 guard quad))
    )
  (set! (-> arg0 flush dword 0) (the-as uint #x3f80000080808080))
  (set! (-> arg0 flush dword 1) (the-as uint 1))
  (none)
  )

;; WARN: Return type mismatch pointer vs none.
(defun generic-add-constants ((arg0 dma-buffer) (arg1 viewport))
  (let* ((a1-0 8)
         (v1-0 arg0)
         (a0-1 (the-as object (-> v1-0 base)))
         )
    (set! (-> (the-as dma-packet a0-1) dma) (new 'static 'dma-tag :id (dma-tag-id cnt) :qwc a1-0))
    (set! (-> (the-as dma-packet a0-1) vif0) (new 'static 'vif-tag :imm #x404 :cmd (vif-cmd stcycl)))
    (set! (-> (the-as dma-packet a0-1) vif1)
          (new 'static 'vif-tag :imm #x381 :cmd (vif-cmd unpack-v4-32) :num a1-0)
          )
    (set! (-> v1-0 base) (&+ (the-as pointer a0-1) 16))
    )
  (generic-setup-constants (the-as generic-constants (-> arg0 base)) arg1)
  (&+! (-> arg0 base) 128)
  (none)
  )

(defun generic-setup-shrub-constants ((arg0 generic-shrub-constants) (arg1 int) (arg2 int) (arg3 int))
  (set! (-> arg0 shrub-giftag fan-prim)
        (new 'static 'gif-tag-prim :pre #x1 :nreg #x3 :prim (the-as gs-prim arg3))
        )
  (set! (-> arg0 shrub-giftag str-prim)
        (new 'static 'gif-tag-prim :pre #x1 :nreg #x3 :prim (the-as gs-prim arg2))
        )
  (set! (-> arg0 shrub-giftag regs)
        (new 'static 'gif-tag-regs-32 :regs0 (gif-reg-id st) :regs1 (gif-reg-id rgbaq) :regs2 (gif-reg-id xyzf2))
        )
  (set! (-> arg0 shrub-giftag num-strips) (the-as uint 0))
  (set! (-> arg0 shrub-adnop dword 0) (the-as uint arg1))
  (set! (-> arg0 shrub-adnop dword 1) (the-as uint 71))
  (none)
  )

;; WARN: Return type mismatch pointer vs none.
(defun generic-add-shrub-constants ((arg0 dma-buffer) (arg1 int) (arg2 int) (arg3 int))
  (let ((v1-0 2)
        (a0-1 *display*)
        (t0-0 64)
        )
    (+! (-> a0-1 mem-reserve-size) t0-0)
    (when (not (-> a0-1 dma-buffer-overflow))
      (let ((t2-0 (-> a0-1 frames (-> a0-1 on-screen) global-buf)))
        (if (< (-> t2-0 real-buffer-end) (the-as int (&+ (-> t2-0 base) t0-0)))
            (set! (-> a0-1 dma-buffer-overflow) #t)
            )
        )
      (when (not (-> a0-1 dma-buffer-overflow))
        (let* ((a0-3 arg0)
               (t0-4 (the-as object (-> a0-3 base)))
               )
          (set! (-> (the-as dma-packet t0-4) dma) (new 'static 'dma-tag :id (dma-tag-id cnt) :qwc v1-0))
          (set! (-> (the-as dma-packet t0-4) vif0) (new 'static 'vif-tag :imm #x404 :cmd (vif-cmd stcycl)))
          (set! (-> (the-as dma-packet t0-4) vif1)
                (new 'static 'vif-tag :imm #x389 :cmd (vif-cmd unpack-v4-32) :num v1-0)
                )
          (set! (-> a0-3 base) (&+ (the-as pointer t0-4) 16))
          )
        )
      )
    )
  (generic-setup-shrub-constants (the-as generic-shrub-constants (-> arg0 base)) arg1 arg2 arg3)
  (&+! (-> arg0 base) 32)
  (none)
  )

(defun generic-init-buf ((arg0 dma-buffer) (arg1 gs-zbuf) (arg2 viewport) (arg3 gs-test))
  (let ((v1-0 *display*)
        (a0-6 (+ (* (+ (/ (-> generic-vu1-block qlength) 127) 1) 16) 304))
        )
    (+! (-> v1-0 mem-reserve-size) a0-6)
    (when (not (-> v1-0 dma-buffer-overflow))
      (let ((a2-1 (-> v1-0 frames (-> v1-0 on-screen) global-buf)))
        (if (< (-> a2-1 real-buffer-end) (the-as int (&+ (-> a2-1 base) a0-6)))
            (set! (-> v1-0 dma-buffer-overflow) #t)
            )
        )
      (when (not (-> v1-0 dma-buffer-overflow))
        (dma-buffer-add-vu-function arg0 generic-vu1-block 1)
        ;; og:preserve-this jakx delta: four A+D registers against jak3's lone zbuf-1;
        ;; frame and scissor come from the viewport, test from the caller.
        (dma-buffer-add-gs-set arg0
                               (zbuf-1 arg1)
                               (frame-1 (-> arg2 frame))
                               (scissor-1 (-> arg2 scissor))
                               (test-1 arg3)
                               )
        (generic-add-constants arg0 arg2)
        (let* ((v1-5 arg0)
               (a0-18 (the-as object (-> v1-5 base)))
               )
          (set! (-> (the-as (pointer int64) a0-18)) #x10000002)
          ;; (s.w! (+ a0-18 8) #x15000000) / (s.w! (+ a0-18 12) #x5000000)
          (set! (-> (the (pointer uint32) (+ (the-as uint a0-18) 8))) (the-as uint #x15000000))
          (set! (-> (the (pointer uint32) (+ (the-as uint a0-18) 12))) (the-as uint #x5000000))
          (set! (-> v1-5 base) (&+ (the-as pointer a0-18) 16))
          )
        (let ((v1-6 (-> arg0 base)))
          (set! (-> (the-as (pointer int32) v1-6)) #x3000000)
          (set! (-> (the (pointer uint32) v1-6) 1) (the-as uint #x2000000))
          (set! (-> (the (pointer uint32) v1-6) 2) (the-as uint 0))
          (set! (-> (the (pointer uint32) v1-6) 3) (the-as uint #x30000000))
          (set! (-> (the (pointer uint32) v1-6) 4) (the-as uint 0))
          (set! (-> (the (pointer uint32) v1-6) 5) (the-as uint 0))
          (set! (-> (the (pointer uint32) v1-6) 6) (the-as uint 0))
          (set! (-> (the (pointer uint32) v1-6) 7) (the-as uint 0))
          (set! (-> arg0 base) (&+ v1-6 32))
          )
        )
      )
    )
  0
  (none)
  )

(defun generic-vu1-init-buf ((arg0 bucket-id) (arg1 gs-zbuf) (arg2 viewport) (arg3 gs-test))
  (let ((v1-0 *display*)
        (t0-0 16)
        )
    (+! (-> v1-0 mem-reserve-size) t0-0)
    (when (not (-> v1-0 dma-buffer-overflow))
      (let ((t2-0 (-> v1-0 frames (-> v1-0 on-screen) global-buf)))
        (if (< (-> t2-0 real-buffer-end) (the-as int (&+ (-> t2-0 base) t0-0)))
            (set! (-> v1-0 dma-buffer-overflow) #t)
            )
        )
      (when (not (-> v1-0 dma-buffer-overflow))
        (let ((gp-0 (-> *display* frames (-> *display* on-screen) bucket-group arg0)))
          (when (!= gp-0 (-> gp-0 last))
            (let* ((s4-0 (-> *display* frames (-> *display* on-screen) global-buf))
                   (s5-3 (-> s4-0 base))
                   )
              (generic-init-buf s4-0 arg1 arg2 arg3)
              (let ((v1-14 (-> s4-0 base)))
                (set! (-> (the-as (pointer uint64) v1-14)) (logior #x20000000 (shr (shl (-> gp-0 next) 33) 1)))
                (set! (-> (the (pointer uint32) v1-14) 2) (the-as uint 0))
                (set! (-> (the (pointer uint32) v1-14) 3) (the-as uint 0))
                (set! (-> s4-0 base) (&+ v1-14 16))
                )
              (set! (-> gp-0 next) (the-as uint s5-3))
              )
            )
          )
        )
      )
    )
  0
  (none)
  )

(defun generic-vu1-init-buf-special ((arg0 bucket-id) (arg1 gs-zbuf) (arg2 viewport) (arg3 gs-test))
  (let ((v1-0 *display*)
        (a1-1 16)
        )
    (+! (-> v1-0 mem-reserve-size) a1-1)
    (when (not (-> v1-0 dma-buffer-overflow))
      (let ((a3-1 (-> v1-0 frames (-> v1-0 on-screen) global-buf)))
        (if (< (-> a3-1 real-buffer-end) (the-as int (&+ (-> a3-1 base) a1-1)))
            (set! (-> v1-0 dma-buffer-overflow) #t)
            )
        )
      (when (not (-> v1-0 dma-buffer-overflow))
        (let ((s3-0 (-> *display* frames (-> *display* on-screen) bucket-group arg0)))
          (when (!= s3-0 (-> s3-0 last))
            (let* ((s1-0 (-> *display* frames (-> *display* on-screen) global-buf))
                   (s2-3 (-> s1-0 base))
                   )
              ;; og:preserve-this runtime-link guard: fx-copy-buf lives in unlanded
              ;; warp.gc (same guard as blit-displays.gc). Until it lands, the warp
              ;; bucket gets its init packets without the framebuffer copy; retires
              ;; with warp.gc.
              (if (nonzero? fx-copy-buf)
                  (fx-copy-buf s1-0 arg2)
                  )
              (generic-init-buf s1-0 arg1 arg2 arg3)
              (let ((v1-14 (-> s1-0 base)))
                (set! (-> (the-as (pointer uint64) v1-14)) (logior #x20000000 (shr (shl (-> s3-0 next) 33) 1)))
                (set! (-> (the (pointer uint32) v1-14) 2) (the-as uint 0))
                (set! (-> (the (pointer uint32) v1-14) 3) (the-as uint 0))
                (set! (-> s1-0 base) (&+ v1-14 16))
                )
              (set! (-> s3-0 next) (the-as uint s2-3))
              )
            )
          )
        )
      )
    )
  0
  (none)
  )

;; og:preserve-this hand-authored from the op-level decomp (expression building dies
;; on bucket id 778, which has no name in the jak3-copied bucket-id enum; raw ids are
;; ground truth per forge #44, same convention as the Generic2 registration). The walk
;; is machine-faithful: per level (19) and viewport (2), six slots each for mercneric
;; (mode 2) and mercneric2 (mode 4) through vu1-bucket-map, zbuf-off plus the depth-
;; writing test #x51001 on slots 3 and 4, zbuf-on with #x5026b elsewhere; then the
;; fixed late ids: 768/770/778/781(special)/788 on viewport 0 and 771/773/779/782
;; (special) on viewport 1, 778/779 with zbuf-off, and the index restored to 0.
(defun generic-vu1-init-buffers ()
  ;; enum corrected at #49: (vu1-renderer-mask generic) is the asm's andi 4096
  (when (logtest? (-> *display* vu1-enable-user) (vu1-renderer-mask generic))
    (dotimes (lev 19)
      (dotimes (vp-idx 2)
        (set! (-> *viewport-array* current-viewport-index) (the-as uint vp-idx))
        (let* ((vp (-> *viewport-array* data vp-idx))
               (zon (the-as gs-zbuf (-> vp zbuf-on)))
               (zoff (the-as gs-zbuf (-> vp zbuf-off)))
               )
          (generic-vu1-init-buf (the-as bucket-id (vu1-bucket-map lev 0 vp-idx (merc-mode mercneric))) zon vp (the-as gs-test #x5026b))
          (generic-vu1-init-buf (the-as bucket-id (vu1-bucket-map lev 1 vp-idx (merc-mode mercneric))) zon vp (the-as gs-test #x5026b))
          (generic-vu1-init-buf (the-as bucket-id (vu1-bucket-map lev 2 vp-idx (merc-mode mercneric))) zon vp (the-as gs-test #x5026b))
          (generic-vu1-init-buf (the-as bucket-id (vu1-bucket-map lev 3 vp-idx (merc-mode mercneric))) zon vp (the-as gs-test #x51001))
          (generic-vu1-init-buf (the-as bucket-id (vu1-bucket-map lev 6 vp-idx (merc-mode mercneric))) zon vp (the-as gs-test #x5026b))
          (generic-vu1-init-buf (the-as bucket-id (vu1-bucket-map lev 4 vp-idx (merc-mode mercneric))) zoff vp (the-as gs-test #x51001))
          (generic-vu1-init-buf (the-as bucket-id (vu1-bucket-map lev 0 vp-idx (merc-mode mercneric2))) zon vp (the-as gs-test #x5026b))
          (generic-vu1-init-buf (the-as bucket-id (vu1-bucket-map lev 1 vp-idx (merc-mode mercneric2))) zon vp (the-as gs-test #x5026b))
          (generic-vu1-init-buf (the-as bucket-id (vu1-bucket-map lev 2 vp-idx (merc-mode mercneric2))) zon vp (the-as gs-test #x5026b))
          (generic-vu1-init-buf (the-as bucket-id (vu1-bucket-map lev 3 vp-idx (merc-mode mercneric2))) zon vp (the-as gs-test #x51001))
          (generic-vu1-init-buf (the-as bucket-id (vu1-bucket-map lev 6 vp-idx (merc-mode mercneric2))) zon vp (the-as gs-test #x5026b))
          (generic-vu1-init-buf (the-as bucket-id (vu1-bucket-map lev 4 vp-idx (merc-mode mercneric2))) zoff vp (the-as gs-test #x51001))
          )
        )
      )
    (set! (-> *viewport-array* current-viewport-index) (the-as uint 0))
    (let ((vp0 (-> *viewport-array* data 0)))
      (generic-vu1-init-buf (the-as bucket-id 768) (the-as gs-zbuf (-> vp0 zbuf-on)) vp0 (the-as gs-test #x5026b))
      (generic-vu1-init-buf (the-as bucket-id 770) (the-as gs-zbuf (-> vp0 zbuf-on)) vp0 (the-as gs-test #x5026b))
      (generic-vu1-init-buf (the-as bucket-id 778) (the-as gs-zbuf (-> vp0 zbuf-off)) vp0 (the-as gs-test #x5026b))
      (generic-vu1-init-buf-special (the-as bucket-id 781) (the-as gs-zbuf (-> vp0 zbuf-on)) vp0 (the-as gs-test #x5026b))
      (generic-vu1-init-buf (the-as bucket-id 788) (the-as gs-zbuf (-> vp0 zbuf-on)) vp0 (the-as gs-test #x5026b))
      )
    (set! (-> *viewport-array* current-viewport-index) (the-as uint 1))
    (let ((vp1 (-> *viewport-array* data 1)))
      (generic-vu1-init-buf (the-as bucket-id 771) (the-as gs-zbuf (-> vp1 zbuf-on)) vp1 (the-as gs-test #x5026b))
      (generic-vu1-init-buf (the-as bucket-id 773) (the-as gs-zbuf (-> vp1 zbuf-on)) vp1 (the-as gs-test #x5026b))
      (generic-vu1-init-buf (the-as bucket-id 779) (the-as gs-zbuf (-> vp1 zbuf-off)) vp1 (the-as gs-test #x5026b))
      (generic-vu1-init-buf-special (the-as bucket-id 782) (the-as gs-zbuf (-> vp1 zbuf-on)) vp1 (the-as gs-test #x5026b))
      )
    (set! (-> *viewport-array* current-viewport-index) (the-as uint 0))
    )
  (none)
  )

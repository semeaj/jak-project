;;-*-Lisp-*-
(in-package goal)

;; name: sprite-distort.gc
;; name in dgo: sprite-distort
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

;; definition of type sprite-distorter-sine-tables
(deftype sprite-distorter-sine-tables (basic)
  ((aspx    float)
   (aspy    float)
   (entry   vector  128 :inline)
   (ientry  qword   9 :inline)
   (giftag  qword   :inline)
   (color   qword   :inline)
   )
  )

;; definition for method 3 of type sprite-distorter-sine-tables
(defmethod inspect ((this sprite-distorter-sine-tables))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this (-> this type))
  (format #t "~1Taspx: ~f~%" (-> this aspx))
  (format #t "~1Taspy: ~f~%" (-> this aspy))
  (format #t "~1Tentry[128] @ #x~X~%" (-> this entry))
  (format #t "~1Tientry[9] @ #x~X~%" (-> this ientry))
  (format #t "~1Tgiftag: #<qword @ #x~X>~%" (-> this giftag))
  (format #t "~1Tcolor: #<qword @ #x~X>~%" (-> this color))
  (label cfg-4)
  this
  )

(kmemopen global "sprite-distort-tables")

;; definition for symbol *sprite-distorter-sine-tables*, type sprite-distorter-sine-tables
(define *sprite-distorter-sine-tables* (new 'global 'sprite-distorter-sine-tables))

(kmemclose)

;; definition for function sprite-distorter-generate-tables
;; WARN: Return type mismatch int vs none.
(defun sprite-distorter-generate-tables ((arg0 math-camera) (arg1 viewport))
  "Regenerate the sprite-distorter-sine-tables for the current camera settings."
  (let ((gp-0 *sprite-distorter-sine-tables*)
        (s3-0 0)
        (s5-0 0)
        (s4-0 3)
        (f28-0 (- (-> arg0 perspective rvec x)))
        (f30-0 (- (-> arg0 perspective uvec y)))
        )
    (when (or (!= f28-0 (-> gp-0 aspx)) (!= f30-0 (-> gp-0 aspy)))
      (let ((f24-0 (/ 1.0 (* 512.0 (-> arg1 ratio-x))))
            (f26-0 (/ 1.0 (* 512.0 (-> arg1 ratio-y))))
            )
        (set! (-> gp-0 aspx) f28-0)
        (set! (-> gp-0 aspy) f30-0)
        (while (< s4-0 12)
          (set! (-> gp-0 ientry s5-0 vector4w x) (+ s3-0 352))
          (+! s5-0 1)
          (dotimes (s2-0 s4-0)
            (let ((f22-0 (* 65536.0 (/ (the float s2-0) (the float s4-0)))))
              (set-vector! (-> gp-0 entry s3-0) (* (sin f22-0) f28-0) (* (cos f22-0) f30-0) 0.0 0.0)
              (let ((s3-1 (+ s3-0 1)))
                (set-vector! (-> gp-0 entry s3-1) (* (sin f22-0) f28-0 f24-0) (* (cos f22-0) f30-0 f26-0) 0.0 0.0)
                (set! s3-0 (+ s3-1 1))
                )
              )
            )
          (+! s4-0 1)
          )
        (set-vector! (-> gp-0 entry s3-0) 0.0 f30-0 0.0 0.0)
        (set-vector! (-> gp-0 entry (+ s3-0 1)) 0.0 (* f30-0 f26-0) 0.0 0.0)
        )
      (set! (-> gp-0 giftag dword 0) (make-u128 0 (the-as uint #xf00a400000008001)))
      (set! (-> gp-0 giftag dword 1) (the-as uint #x412412412412412))
      (set! (-> gp-0 color vector4w x) 128)
      (set! (-> gp-0 color vector4w y) 128)
      (set! (-> gp-0 color vector4w z) 128)
      (set! (-> gp-0 color vector4w w) 128)
      )
    )
  0
  (none)
  )

;; definition for symbol sprite-distort-vu1-block, type vu-function
;; og:preserve-this length args commented out: the vu function stays empty so the PC upload is zero-size (jak3 parity)
(define sprite-distort-vu1-block (new 'static 'vu-function #|:length 63 :qlength 32|#))

;; definition for function sprite-init-distorter
;; WARN: Return type mismatch int vs none.
(defun sprite-init-distorter ((arg0 dma-buffer) (arg1 viewport))
  "Generate DMA to initialize the distort renderer."
  (dma-buffer-add-gs-set arg0
                         (zbuf-1 (-> arg1 zbuf-off))
                         (tex0-1 (-> arg1 tex0))
                         (tex1-1 (new 'static 'gs-tex1 :mmag #x1 :mmin #x1))
                         (miptbp1-1 (new 'static 'gs-miptbp))
                         (clamp-1 (-> arg1 clamp))
                         (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1))
                         )
  ;; send current aspect used by the sine tables (PC only). og:preserve-this
  ;; port addition, not retail code: the C++ renderer asserts this packet for every game version (Sprite3_Distort.cpp:264-268)
  (#when PC_PORT
    (let ((packet (the-as dma-packet (-> arg0 base))))
      (set! (-> packet dma) (new 'static 'dma-tag :id (dma-tag-id cnt) :qwc 1))
      (set! (-> packet vif0) (new 'static 'vif-tag))
      (set! (-> packet vif1) (new 'static 'vif-tag :cmd (vif-cmd pc-port)))
      (&+! (-> arg0 base) 16)
      )
    (let ((aspect-vec (the-as vector (-> arg0 base))))
      (set-vector! aspect-vec
                   (-> *sprite-distorter-sine-tables* aspx)
                   (-> *sprite-distorter-sine-tables* aspy)
                   0.0
                   0.0
                   )
      (&+! (-> arg0 base) 16)
      )
    )
  (let* ((v1-3 arg0)
         (a1-6 (the-as dma-packet (-> v1-3 base)))
         )
    (set! (-> a1-6 dma) (new 'static 'dma-tag
                          :qwc #x8b
                          :id (dma-tag-id ref)
                          :addr (the-as int (-> *sprite-distorter-sine-tables* entry))
                          )
          )
    (set! (-> a1-6 vif0) (new 'static 'vif-tag :imm #x404 :cmd (vif-cmd stcycl)))
    (set! (-> a1-6 vif1) (new 'static 'vif-tag :imm #x160 :num #x8b :cmd (vif-cmd unpack-v4-32)))
    (set! (-> v1-3 base) (the-as pointer (&+ a1-6 16)))
    )
  (dma-buffer-add-vu-function arg0 sprite-distort-vu1-block 1)
  0
  (none)
  )

;; definition for function sprite-draw-distorters
;; INFO: Used lq/sq
;; WARN: Return type mismatch int vs none.
;; ERROR: Inline assembly instruction marked with TODO - [TODO.VCLIP]
;; ERROR: Unsupported inline assembly instruction kind - [cfc2.i v1, Clipping]
(defun sprite-draw-distorters ((arg0 dma-buffer) (arg1 viewport))
  "Generate DMA to draw all distort sprites."
  (local-vars (v1-17 float) (v1-18 float) (v1-23 int) (v1-67 float))
  (rlet ((acc :class vf)
         (Q :class vf)
         (vf0 :class vf)
         (vf1 :class vf)
         (vf10 :class vf)
         (vf2 :class vf)
         (vf3 :class vf)
         (vf4 :class vf)
         (vf5 :class vf)
         (vf6 :class vf)
         (vf8 :class vf)
         (vf9 :class vf)
         )
    (init-vf0-vector)
    (let ((f30-0 (/ 1.0 (* 512.0 (-> arg1 ratio-x))))
          (f28-0 (/ 1.0 (* 512.0 (-> arg1 ratio-y))))
          )
      (.lvf vf8 (&-> (view-get-active-math-camera) hmge-scale quad))
      (let ((sv-16 (-> arg0 base))
            (s4-0 0)
            (s5-0 0)
            )
        (&+! (-> arg0 base) 16)
        (let* ((s2-0 *sprite-aux-list*)
               (s1-0 (-> s2-0 entry))
               )
          (dotimes (s0-0 s1-0)
            (let ((v1-9 (-> s2-0 data s0-0)))
              (when (= (-> v1-9 aux-type) (sprite-aux-type distort))
                (let* ((sv-32 (-> v1-9 vec-data))
                       (sv-48 (-> arg0 base))
                       (sv-64 (&+ sv-48 16))
                       (sv-80 (&+ sv-48 32))
                       )
                  (cond
                    ((= (the-as int (-> sv-32 flag-rot-sy y)) 1)
                     (.lvf vf3 (&-> (view-get-active-math-camera) sprite-2d rvec quad))
                     (.lvf vf4 (&-> (view-get-active-math-camera) sprite-2d uvec quad))
                     (.lvf vf5 (&-> (view-get-active-math-camera) sprite-2d fvec quad))
                     (.lvf vf6 (&-> (view-get-active-math-camera) sprite-2d trans quad))
                     (.lvf vf9 (&-> (view-get-active-math-camera) sprite-2d-hvdf quad))
                     (.mov v1-17 vf9)
                     )
                    (else
                      (.lvf vf3 (&-> (view-get-active-math-camera) camera-temp rvec quad))
                      (.lvf vf4 (&-> (view-get-active-math-camera) camera-temp uvec quad))
                      (.lvf vf5 (&-> (view-get-active-math-camera) camera-temp fvec quad))
                      (.lvf vf6 (&-> (view-get-active-math-camera) camera-temp trans quad))
                      (.lvf vf9 (&-> (view-get-active-math-camera) hvdf-off quad))
                      (.mov v1-18 vf9)
                      )
                    )
                  (.lvf vf1 (&-> sv-32 x-y-z-sx quad))
                  (.lvf vf2 (&-> sv-32 r-g-b-a quad))
                  (.mul.w.vf acc vf6 vf0)
                  (.add.mul.x.vf acc vf3 vf1 acc)
                  (.add.mul.y.vf acc vf4 vf1 acc)
                  (.add.mul.z.vf vf1 vf5 vf1 acc)
                  (.mul.vf vf10 vf1 vf8)
                  (.div.vf Q vf0 vf10 :fsf #b11 :ftf #b11)
                  ;; (TODO.VCLIP vf10 vf10) og:preserve-this
                  (b! (zero? (-> sv-32 flag)) cfg-22 :delay (nop!))
                  (.wait.vf)
                  (.mul.vf.xyz vf1 vf1 Q)
                  (.mul.vf.xyz vf2 vf2 Q)
                  (set! v1-23 (vu-clip vf10 0)) ;; safe to just drop the higher bits. og:preserve-this
                  ;; (.cfc2.i v1-23 Clipping)
                  (b! (logtest? v1-23 63) cfg-22 :delay (.add.vf vf1 vf1 vf9))
                  (.max.x.vf.w vf1 vf1 vf0)
                  ;; og:preserve-this s.vf! is decompiler IR with no goalc form; jak3's
                  ;; .svf shape carries the same stores
                  (.svf (&-> (the-as vector sv-48) quad) vf1)
                  (.svf (&-> (the-as vector sv-80) quad) vf2)
                  ;; og:preserve-this pointer-math stores converted to jak3's typed
                  ;; field forms (goalc rejects raw pointer arithmetic in s.f!/s.w!)
                  (set! (-> (the-as vector sv-48) w) 255.0)
                  (set! (-> (the-as vector sv-64) x)
                        (+ (* f30-0
                              (+ (- (-> (the-as (pointer float) sv-48)) (the float (-> arg1 screen-cx))) (the float (-> arg1 screen-hx)))
                              )
                           (/ 1.0 (* 1024.0 (-> arg1 ratio-x)))
                           )
                        )
                  (let ((f0-12
                          (+ (* f28-0 (+ (- (-> (the-as vector sv-48) y) (the float (-> arg1 screen-cy))) (the float (-> arg1 screen-hy))))
                             (/ 1.0 (* 1024.0 (-> arg1 ratio-y)))
                             )
                          )
                        )
                    (set! (-> (the-as vector sv-64) y) f0-12)
                    )
                  (set! (-> (the-as vector sv-64) z) 1.0)
                  (when (or (< (-> sv-32 flag) 3) (< 11 (-> sv-32 flag)))
                    (format 0 "Turns = ~D!!!~%" (-> sv-32 flag))
                    (set! (-> sv-32 flag) 11)
                    )
                  (set! (-> (the-as vector sv-64) w) (the-as float (-> sv-32 flag)))
                  (let* ((f0-15 (- (-> (view-get-active-math-camera) perspective uvec y)))
                         (f2-6 (-> (the-as vector sv-64) y))
                         (f4-0 (+ f2-6 (* (-> (the-as (pointer float) sv-80)) f0-15)))
                         (f3-2 (the float (-> arg1 screen-hx)))
                         (f1-19 (-> (the-as (pointer float) sv-80)))
                         )
                    (if (< (the float (-> arg1 screen-sy)) f4-0)
                        (set! f3-2 (/ (- (the float (-> arg1 screen-sy)) f2-6) f0-15))
                        )
                    (if (< 128.0 f3-2)
                        (set! f3-2 128.0)
                        )
                    (when (< f3-2 f1-19)
                      (let ((v1-65 (/ f3-2 f1-19)))
                        (.mov vf1 v1-65)
                        )
                      (.mul.x.vf vf2 vf2 vf1)
                      ;; og:preserve-this s.vf! converted to jak3's .svf shape
                      (.svf (&-> (the-as vector sv-80) quad) vf2)
                      (.mov v1-67 vf2)
                      )
                    )
                  )
                (&+! (-> arg0 base) 48)
                (+! s4-0 1)
                (when (= s4-0 85)
                  (let ((v1-72 (-> arg0 base)))
                    (set! (-> arg0 base) sv-16)
                    (let* ((a0-12 arg0)
                           (a1-2 (-> a0-12 base))
                           )
                      (set! (-> (the-as (pointer int64) a1-2)) (logior #x10000000 (shr (shl (* 3 s4-0) 48) 48)))
                      (set! (-> (the-as (pointer uint32) a1-2) 2) (the-as uint 0))
                      (let ((a2-5 (logior (logior #x6c000000 (shr (shl (* 3 s4-0) 56) 40))
                                          (shr (shl (shr (shl (+ (* 3 s5-0) 512) 54) 54) 48) 48)
                                          )
                                  )
                            )
                        (set! (-> (the-as (pointer uint32) a1-2) 3) (the-as uint a2-5))
                        )
                      (set! (-> a0-12 base) (&+ a1-2 16))
                      )
                    (set! (-> arg0 base) v1-72)
                    )
                  (set! s4-0 0)
                  (+! s5-0 85)
                  (when (= s5-0 170)
                    (let* ((v1-75 arg0)
                           (a0-13 (-> v1-75 base))
                           )
                      (set! (-> (the-as (pointer int64) a0-13)) #x10000001)
                      (set! (-> (the-as (pointer uint32) a0-13) 2) (the-as uint 0))
                      (let ((a1-5 #x6c0101ff))
                        (set! (-> (the-as (pointer uint32) a0-13) 3) (the-as uint a1-5))
                        )
                      (set! (-> v1-75 base) (&+ a0-13 16))
                      )
                    (let* ((v1-76 arg0)
                           (a0-15 (-> v1-76 base))
                           )
                      (set! (-> (the-as (pointer int32) a0-15)) s5-0)
                      (set! (-> (the-as (pointer uint32) a0-15) 1) (the-as uint 0))
                      (set! (-> (the-as (pointer uint32) a0-15) 2) (the-as uint 0))
                      (set! (-> (the-as (pointer uint32) a0-15) 3) (the-as uint 0))
                      (set! (-> v1-76 base) (&+ a0-15 16))
                      )
                    (let* ((v1-77 arg0)
                           (a0-17 (-> v1-77 base))
                           )
                      (set! (-> (the-as (pointer int64) a0-17)) #x10000000)
                      (let ((a1-7 #x15000000))
                        (set! (-> (the-as (pointer uint32) a0-17) 2) (the-as uint a1-7))
                        )
                      (let ((a1-8 #x11000000))
                        (set! (-> (the-as (pointer uint32) a0-17) 3) (the-as uint a1-8))
                        )
                      (set! (-> v1-77 base) (&+ a0-17 16))
                      )
                    (set! s5-0 0)
                    )
                  (set! sv-16 (-> arg0 base))
                  (&+! (-> arg0 base) 16)
                  )
                )
              )
            (label cfg-22)
            0
            )
          )
        (cond
          ((zero? s4-0)
           (set! (-> arg0 base) sv-16)
           (nop!)
           0
           )
          (else
            (let ((v1-87 (-> arg0 base)))
              (set! (-> arg0 base) sv-16)
              (let* ((a0-20 arg0)
                     (a1-9 (-> a0-20 base))
                     )
                (set! (-> (the-as (pointer int64) a1-9)) (logior #x10000000 (shr (shl (* 3 s4-0) 48) 48)))
                (set! (-> (the-as (pointer uint32) a1-9) 2) (the-as uint 0))
                (let ((a2-10 (logior (logior #x6c000000 (shr (shl (* 3 s4-0) 56) 40))
                                     (shr (shl (shr (shl (+ (* 3 s5-0) 512) 54) 54) 48) 48)
                                     )
                             )
                      )
                  (set! (-> (the-as (pointer uint32) a1-9) 3) (the-as uint a2-10))
                  )
                (set! (-> a0-20 base) (&+ a1-9 16))
                )
              (set! (-> arg0 base) v1-87)
              )
            )
          )
        (let ((v1-88 (+ s4-0 s5-0)))
          (when (nonzero? v1-88)
            (let* ((a0-22 arg0)
                   (a1-11 (-> a0-22 base))
                   )
              (set! (-> (the-as (pointer int64) a1-11)) #x10000001)
              (set! (-> (the-as (pointer uint32) a1-11) 2) (the-as uint 0))
              (let ((a2-12 #x6c0101ff))
                (set! (-> (the-as (pointer uint32) a1-11) 3) (the-as uint a2-12))
                )
              (set! (-> a0-22 base) (&+ a1-11 16))
              )
            (let* ((a0-23 arg0)
                   (a1-13 (-> a0-23 base))
                   )
              (set! (-> (the-as (pointer int32) a1-13)) v1-88)
              (set! (-> (the-as (pointer uint32) a1-13) 1) (the-as uint 0))
              (set! (-> (the-as (pointer uint32) a1-13) 2) (the-as uint 0))
              (set! (-> (the-as (pointer uint32) a1-13) 3) (the-as uint 0))
              (set! (-> a0-23 base) (&+ a1-13 16))
              )
            (let ((v1-90 (-> arg0 base)))
              (set! (-> (the-as (pointer int64) v1-90)) #x10000000)
              (let ((a0-25 #x15000000))
                (set! (-> (the-as (pointer uint32) v1-90) 2) (the-as uint a0-25))
                )
              (let ((a0-26 #x11000000))
                (set! (-> (the-as (pointer uint32) v1-90) 3) (the-as uint a0-26))
                )
              (set! (-> arg0 base) (&+ v1-90 16))
              )
            )
          )
        )
      )
    0
    (none)
    )
  )

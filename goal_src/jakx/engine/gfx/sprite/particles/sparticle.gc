;; definition for function spt-func-on-omega-height-die
;; WARN: Return type mismatch symbol vs none.
(defun spt-func-on-omega-height-die ((arg0 sparticle-system) (arg1 sparticle-cpuinfo) (arg2 sparticle-launchinfo))
  (let ((f0-0 (-> arg1 key 0 origin trans y))
        (f1-0 (-> arg1 omega))
        )
    (if (if (>= f1-0 0.0)
            (< (+ f0-0 f1-0) (-> arg2 launchrot y))
            (< (-> arg2 launchrot y) (+ f0-0 f1-0))
            )
        (sp-kill-particle arg0 arg1)
        )
    )
  (none)
  )





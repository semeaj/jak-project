;; definition for function kill-all-particles-with-control
;; WARN: Return type mismatch int vs none.
(defun kill-all-particles-with-control ((arg0 sparticle-launch-control))
  (forall-particles-with-control
    (the-as sparticle-launch-control (-> arg0 pointer-control))
    sparticle-kill-it
    #t
    #t
    )
  0
  (none)
  )

;; definition for method 21 of type sparticle-launch-control
;; WARN: Return type mismatch int vs none.
(defmethod sparticle-launch-control-method-21 ((this sparticle-launch-control))
  (countdown (v1-0 (-> this length))
    (let ((a0-4 (-> this data v1-0)))
      (logclear! (-> a0-4 flags) (sp-launch-state-flags sp1))
      )
    )
  (set! (-> this local-clock) 0)
  (let ((a0-5 (-> this local-space-binding)))
    (if a0-5
        (move-to-dead a0-5)
        )
    )
  (kill-all-particles-with-control this)
  0
  (none)
  )

;; definition for method 19 of type sparticle-launch-control
;; WARN: Return type mismatch int vs none.
;; ERROR: Failed store: (s.w! v1-5 #f) at op 13
(defmethod kill-particles ((this sparticle-launch-control))
  (sparticle-launch-control-method-21 this)
  (if (> (-> this matrix) 0)
      (sprite-release-user-hvdf (-> this matrix))
      )
  (let ((v1-5 (-> this pointer-control)))
    (s.w! v1-5 #f)
    )
  (set! (-> this pointer-control) (the-as uint #f))
  0
  (none)
  )

;; definition for method 12 of type sparticle-launch-control
(defmethod clear-2 ((this sparticle-launch-control))
  "Set length to 0"
  (kill-all-particles-with-control this)
  0
  )


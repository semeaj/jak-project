;; definition of type particle-adgif-cache
(deftype particle-adgif-cache (basic)
  ((used     int32)
   (last     uint16)
   (lastgif  adgif-shader)
   (tidhash  uint16        80)
   (spadgif  adgif-shader  80 :inline)
   )
  )

;; definition for method 3 of type particle-adgif-cache
(defmethod inspect ((this particle-adgif-cache))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this (-> this type))
  (format #t "~1Tused: ~D~%" (-> this used))
  (format #t "~1Tlast: ~D~%" (-> this last))
  (format #t "~1Tlastgif: #<adgif-shader @ #x~X>~%" (-> this lastgif))
  (format #t "~1Ttidhash[80] @ #x~X~%" (-> this tidhash))
  (format #t "~1Tspadgif[80] @ #x~X~%" (-> this spadgif))
  (label cfg-4)
  this
  )


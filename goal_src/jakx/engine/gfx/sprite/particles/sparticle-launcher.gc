;; definition for method 3 of type sp-launch-stack
;; INFO: Used lq/sq
(defmethod inspect ((this sp-launch-stack))
  (when (not this)
    (set! this this)
    (goto cfg-4)
    )
  (format #t "[~8x] ~A~%" this 'sp-launch-stack)
  (format #t "~1Tra: ~A~%" (-> this ra))
  (format #t "~1Tdummy0: ~A~%" (-> this dummy0))
  (format #t "~1Tdummy1: ~A~%" (-> this dummy1))
  (format #t "~1Tb-spfic: ~A~%" (-> this b-spfic))
  (format #t "~1Tr16: ~D~%" (-> this r16))
  (format #t "~1Tr17: ~D~%" (-> this r17))
  (format #t "~1Tr18: ~D~%" (-> this r18))
  (format #t "~1Tpos: ~D~%" (-> this pos))
  (format #t "~1Tmatrix: #<matrix @ #x~X>~%" (-> this matrix))
  (format #t "~1Tl-spfic: ~A~%" (-> this l-spfic))
  (format #t "~1Tbirth-info: #<sparticle-birthinfo @ #x~X>~%" (-> this birth-info))
  (format #t "~1Tsprite: #<sprite-vec-data-2d @ #x~X>~%" (-> this sprite))
  (format #t "~1Tr19: ~D~%" (-> this r19))
  (format #t "~1Tr20: ~D~%" (-> this r20))
  (format #t "~1Tr21: ~D~%" (-> this r21))
  (format #t "~1Tr22: ~D~%" (-> this r22))
  (format #t "~1Tis-3d: ~D~%" (-> this is-3d))
  (label cfg-4)
  this
  )


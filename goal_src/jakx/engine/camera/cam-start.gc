;;-*-Lisp-*-
(in-package goal)

;; name: cam-start.gc
;; name in dgo: cam-start
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

(defun cam-stop ()
  (kill-by-name "camera-master" *active-pool*)
  (kill-by-name "camera-slave" *active-pool*)
  (kill-by-name "camera-combiner" *active-pool*)
  (view-set-active-camera (the-as basic #f))
  (view-set-active-camera-combiner (the-as basic #f))
  #f
  )

(defun cam-start ((arg0 symbol))
  (cam-stop)
  (view-set-active-camera-combiner (the-as basic (ppointer->process (process-spawn
                                                                      camera-combiner
                                                                      :init cam-combiner-init
                                                                      :name "camera-combiner"
                                                                      :from *camera-dead-pool*
                                                                      :to *camera-pool*
                                                                      )
                                                                    )
                                           )
                                   )
  (view-set-active-camera (the-as basic (ppointer->process (process-spawn
                                                             camera-master
                                                             :init cam-master-init
                                                             :name "camera-master"
                                                             :from *camera-master-dead-pool*
                                                             :to *camera-pool*
                                                             )
                                                           )
                                  )
                          )
  0
  (none)
  )

;; og:preserve-this bring-up gate: the retail top-level runs cam-start once per view
;; (view-push-context i / cam-start / view-pop-context, i = 0..1). cam-states is
;; landed now, but the first (go cam-combiner-active) dies INSIDE the go/enter-state
;; machinery (this is the first defstate dispatch the jakx bring-up exercises; the
;; init behavior completes, the :code never starts). Debug the jakx gstate/gkernel
;; state path, then flip to #t (or call (jakx-cam-start-now) from the REPL).
(define *jakx-cam-start* #f)

(defun jakx-cam-start-now ()
  (dotimes (i 2)
    (view-push-context i)
    (cam-start #f)
    (view-pop-context)
    )
  0
  )

(if *jakx-cam-start*
    (jakx-cam-start-now)
    )

;;-*-Lisp-*-
(in-package goal)

;; name: process-drawable.gc
;; name in dgo: process-drawable
;; dgos: ENGINE, GAME

;; +++attack-mask
(defenum attack-mask
  :bitfield #t
  :type uint32
  (trans        0) ;; 1
  (vector       1) ;; 2
  (intersection 2) ;; 4
  (attacker     3) ;; 8
  (attack-time  4) ;; 16
  (invinc-time  5) ;; 32
  (mode         6) ;; 64
  (shove-back   7) ;; 128
  (shove-up     8) ;; 256
  (speed        9) ;; 512
  (dist        10) ;; 1024
  (control     11) ;; 2048
  (angle       12) ;; 4096
  (rotate-to   13) ;; 8192
  (prev-state  14) ;; 16384
  (id          15) ;; 32768
  (count       16) ;; hi 1
  (penetrate-using 17) ;; hi 2
  (attacker-velocity 18);; hi 4
  (damage      19) ;; hi 8
  (shield-damage 20) ;; hi16
  (vehicle-damage-factor        21) ;; hi 32
  (vehicle-impulse-factor         22) ;; hi 64
  (knock 23)
  (test 24)
  (wpn-type 25)
  )
;; ---attack-mask

;; og:preserve-this externs for a later-building object (add-process-drawable lives in
;; drawable.o, game.gd line 317 vs process-drawable.o at 293) and an unlanded one
;; (cspace<-parented-matrix-joint! belongs to joint.o, still a stub); jak3 keeps the
;; same kind of block at the top of its process-drawable.gc.
(define-extern add-process-drawable (function process-drawable draw-control symbol dma-buffer none))
(define-extern cspace<-parented-matrix-joint! (function cspace matrix matrix))

;; DECOMP BEGINS


;; DECOMP BEGINS

;; og:preserve-this partial landing: the two engine walkers run every frame from
;; display-loop-main. Hand-written from process-drawable_ir2.asm (the handle-deref
;; pattern degrades their decomp to raw ops); the shape matches jak3 exactly, with
;; jakx reading node-list/draw/skel at 192/196/200. setup-cspace-and-add (rung 4)
;; is landed at the end of the file, verbatim from clean machine output. The rest
;; of process-drawable.o stays pending.

(defun execute-math-engine ()
  ;; og:preserve-this the do-joint-math body (joint.o home) is not landed yet, so the
  ;; draw-control method slot links as 0. *matrix-engine* stays empty until
  ;; process-drawables register, which cannot happen before joint.o lands, so the
  ;; dispatch is unreachable until then.
  (let ((gp-0 *matrix-engine*))
    (let ((s5-0 (-> gp-0 length)))
      (dotimes (s4-0 s5-0)
        (let ((v1-3 (handle->process (-> gp-0 s4-0))))
          (if v1-3
              (do-joint-math
                (-> (the-as process-drawable v1-3) draw)
                (-> (the-as process-drawable v1-3) node-list)
                (-> (the-as process-drawable v1-3) skel)
                )
              )
          )
        )
      )
    (set! (-> gp-0 length) 0)
    )
  0
  0
  )

;; og:preserve-this bring-up stub: the real body walks each registered process's
;; draw cloth-instances calling update! (cloth-system method 9), but cloth-system is
;; only declare-typed until cloth-h lands. *cloth-engine* stays empty headless.
(defun execute-cloth-engine ()
  (set! (-> *cloth-engine* length) 0)
  0
  0
  )

(defstate empty-state (process)
  :code nothing
  )

;; og:preserve-this landed as a plain defun (retail keeps this in the debug segment
;; and falls back to nothing in release); add-debug-text-3d lives in unlanded
;; debug.gc, so its call carries a runtime-link guard. jakx deltas vs jak3: debug
;; text bucket 785 (jak3 577) and no ~2j prefix in the format string.
(defun process-drawable-error-print ((arg0 process-drawable) (arg1 string))
  (when (and *display-entity-errors* (not *display-capture-mode*) (nonzero? add-debug-text-3d))
    (let ((s4-0 (cond
                  ((nonzero? (-> arg0 root))
                   (-> arg0 root trans)
                   )
                  ((-> arg0 entity)
                   (-> arg0 entity extra trans)
                   )
                  (else
                    (the-as vector #f)
                    )
                  )
                )
          )
      (when s4-0
        (let ((s3-0 add-debug-text-3d)
              (s2-0 #t)
              (s1-0 785)
              )
          (format (clear *temp-string*) "~s error for ~s" arg1 (-> arg0 name))
          (s3-0 s2-0 (the-as bucket-id s1-0) *temp-string* s4-0 (font-color red) (the-as vector2h #f))
          )
        )
      )
    )
  0
  (none)
  )

(defstate process-drawable-art-error (process-drawable)
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('nav-mesh-kill)
       (deactivate self)
       #t
       )
      )
    )
  :enter (behavior ((arg0 string))
    (if (and (-> self prev-state) (nonzero? (-> self prev-state)))
        (format 0 "process ~A in process-drawable-art-error from state ~S~%" (-> self name) (-> self prev-state name))
        )
    (if (-> self entity)
        (logior! (-> self entity extra perm status) (entity-perm-status error))
        )
    (let ((v1-12 (as-type (-> self root) collide-shape)))
      (when v1-12
        (let ((a0-6 (-> v1-12 root-prim)))
          (set! (-> a0-6 prim-core collide-as) (collide-spec))
          (set! (-> a0-6 prim-core collide-with) (collide-spec))
          )
        (set! (-> v1-12 backup-collide-as) (collide-spec))
        (set! (-> v1-12 backup-collide-with) (collide-spec))
        0
        )
      )
    )
  :code (behavior ((arg0 string))
    (let ((sv-8 arg0))
      (until #f
        (process-drawable-error-print self sv-8)
        (suspend)
        )
      )
    #f
    )
  )

(defmethod setup-cspace-and-add ((this draw-control) (jgeo art-joint-geo) (allocation symbol))
  (let ((s5-0 ((method-of-type cspace-array new) allocation cspace-array (+ (-> jgeo length) 1))))
    (let ((v0-1 ((method-of-type skeleton new) allocation skeleton (+ (-> jgeo length) 1))))
      (set! (-> this skeleton) v0-1)
      (let ((s3-1 v0-1))
        (when (or (zero? s5-0) (zero? s3-1))
          (go process-drawable-art-error "memory")
          (set! s5-0 (the-as cspace-array #f))
          (goto cfg-13)
          )
        (let ((v1-9 ((method-of-type cspace reset-and-assign-geo!) (-> s5-0 data 0) (the-as drawable #f))))
          (set! (-> v1-9 bone) (the-as bone (-> s3-1 bones)))
          )
        (let ((v1-10 (-> s5-0 data)))
          (set! (-> v1-10 0 param0) (the-as (function cspace transformq none) cspace<-transformq!))
          (set! (-> v1-10 0 param1) (the-as basic (-> this process root trans)))
          )
        (let ((v1-12 (reset-and-assign-geo! (-> s5-0 data 1) (the-as drawable #f))))
          (set! (-> v1-12 joint) (-> jgeo data 0))
          (set! (-> v1-12 bone) (-> s3-1 bones 1))
          (set! (-> v1-12 parent) (the-as cspace (-> s5-0 data)))
          )
        (let ((v1-14 (reset-and-assign-geo! (-> s5-0 data 2) (the-as drawable #f))))
          (set! (-> v1-14 joint) (-> jgeo data 1))
          (set! (-> v1-14 bone) (-> s3-1 bones 2))
          (set! (-> v1-14 parent) (the-as cspace (-> s5-0 data)))
          (set! (-> v1-14 param0) (the-as (function cspace transformq none) cspace<-parented-matrix-joint!))
          (set! (-> v1-14 param1) (-> this process))
          )
        (let ((s2-0 3))
          (while (< s2-0 (-> s5-0 length))
            (let* ((s0-0 (-> jgeo data (+ s2-0 -1)))
                   (s1-0 (if (-> s0-0 parent)
                             (+ (-> s0-0 parent number) 1)
                             0
                             )
                         )
                   (v1-25 (reset-and-assign-geo! (-> s5-0 data s2-0) (the-as drawable #f)))
                   )
              (set! (-> v1-25 joint) s0-0)
              (set! (-> v1-25 bone) (-> s3-1 bones s2-0))
              (set! (-> v1-25 parent) (-> s5-0 data s1-0))
              )
            (+! s2-0 1)
            )
          )
        )
      )
    (add-connection *foreground-draw-engine* (-> this process) add-process-drawable (-> this process) this #f)
    (label cfg-13)
    s5-0
    )
  )

      (dotimes (a0-4 (-> this length))
        (let ((a1-8 (-> this level a0-4)))
          (when (= (-> a1-8 status) 'active)
            (if (and (= (-> a1-8 name) v1-6) (not (logtest? (-> a1-8 info level-flags) (level-flags not-physical))))
                (return a1-8)
                )
            )
          )
        )
      )
    (let ((s4-1 (the-as level #f)))
      (let ((f30-0 0.0))
        (dotimes (s3-0 (-> this length))
          (let ((s2-0 (-> this level s3-0)))
            (when (= (-> s2-0 status) 'active)

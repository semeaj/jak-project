;; definition for function bg
;; WARN: Return type mismatch int vs none.
(defun bg ((arg0 symbol))
  (set! *cheat-mode* (if *debug-segment*
                         'debug
                         #f
                         )
        )
  (let ((v1-2 (lookup-level-info arg0)))
    (cond
      ((= (-> v1-2 visname) arg0)
       (set! (-> *level* vis?) #t)
       (set! arg0 (-> v1-2 name))
       )
      (else
        (set! (-> *level* vis?) #f)
        (set! (-> *kernel-context* low-memory-message) #f)
        )
      )
    )
  0
  (let ((s5-0 (level-get-for-use *level* arg0 'active -1)))
    (while (and s5-0
                (or (= (-> s5-0 status) 'loading) (= (-> s5-0 status) 'loading-bt) (= (-> s5-0 status) 'login))
                (not *dproc*)
                )
      (load-continue s5-0)
      )
    (reset! *load-state*)
    (set! (-> *load-state* vis-nick) (-> s5-0 name))
    (set! (-> *load-state* want 0 name) (-> s5-0 name))
    (set! (-> *load-state* want 0 display?) 'display)
    ;; og:preserve-this bring-up shim: the load-state update! method (which propagates
    ;; want -> target -> level display?) is not landed yet, so flip the level's
    ;; display? directly at boot activation. Retire with the update! landing.
    (if s5-0
        (set! (-> s5-0 display?) 'display)
        )
    (when (-> s5-0 info continues)
      (dotimes (s4-0 2)
        (let* ((a0-15 *game-info*)
               (t9-4 (method-of-object a0-15 set-continue!))
               (a1-2 (-> s5-0 info continues car))
               (a2-1 s4-0)
               )
          (t9-4 a0-15 (the-as basic a1-2) a2-1)
          )
        )
      )
    )
  (dotimes (v1-32 1)
    (set! (-> *load-state* want-sound v1-32 name)
          (-> *game-info* player-info 0 current-continue want-sound v1-32)
          )
    (set! (-> *load-state* want-sound v1-32 mode) (sound-bank-mode full))
    )
  (add-borrow-levels *load-state*)
  (activate-levels! *level*)
  (set! *print-login* #f)
  (cond
    ((= arg0 'halfpipe)
     (send-event (ppointer->process *time-of-day*) 'change 'ratio 0.0)
     (send-event (ppointer->process *time-of-day*) 'change 'hour 14)
     (set! (-> *time-of-day-context* mode) (time-of-day-palette-id unk0 unk1))
     )
    (else
      (set! (-> *time-of-day-context* mode) (time-of-day-palette-id unk3))
      )
    )
  0
  (none)
  )

;; definition for function play
;; og:preserve-this bring-up extern: home is cam-start.gc, which compiles after the
;; camera ring types this file cannot see. Retire with the warp helper.
(define-extern jakx-cam-warp-to-level (function level none))

(defun play ((arg0 symbol) (arg1 symbol))
  (kmemopen global "level-boot")
  (format 0 "(play)~%")
  (when *kernel-boot-level*
    (bg (string->symbol (the-as string *kernel-boot-level*)))
    (on #f)
    (kmemclose)
    (kmemclose)
    (return 0)
    )
  (let* ((v1-3 *kernel-boot-message*)
         (s5-0 (cond
                 ((= v1-3 'kiosk)
                  'fmvlev
                  )
                 (*debug-segment*
                   'menu2
                   )
                 (else
                   ;; og:preserve-this bring-up lever: retail boots 'fmvlev (the intro
                   ;; movie level); *jakx-boot-level* picks the level to exercise the
                   ;; load chain with (brdroom = smallest real world-geometry DGO)
                   *jakx-boot-level*
                   )
                 )
               )
         )
    (let ((t9-7 stop)
          (a0-7 'play)
          )
      0
      (t9-7 a0-7)
      )
    (set! (-> *level* vis?) arg0)
    (set! (-> *level* want-level) #f)
    (set! (-> *level* border?) #t)
    (set! (-> *setting-control* user-default border-mode) #t)
    (set! (-> *level* play?) #t)
    (init-level-system *level* #t)
    (set! *display-profile* #f)
    (set! *cheat-mode* (if *debug-segment*
                           'debug
                           #f
                           )
          )
    (set! *time-of-day-fast* #f)
    ;; og:preserve-this added nonzero check, matching jak3's PC port: *time-of-day* is not
    ;; spawned yet on the jakx bring-up (time-of-day.gc not decompiled).
    (when (nonzero? *time-of-day*)
      (send-event (ppointer->process *time-of-day*) 'change 'ratio 1.0)
      (send-event (ppointer->process *time-of-day*) 'change 'hour 7)
      (send-event (ppointer->process *time-of-day*) 'change 'minutes 0)
      (send-event (ppointer->process *time-of-day*) 'change 'seconds 0)
      (send-event (ppointer->process *time-of-day*) 'change 'frames 0)
      )
    (set! (-> *time-of-day-context* mode) (time-of-day-palette-id unk3))
    (set! (-> *mood-control* overide-weather-flag) #f)
    (set-blackout-frames (seconds 0.02))
    (when (not *dproc*)
      (reset! *load-state*)
      ;; og:preserve-this temp guard: the level table is real now, but load-begin (and the
      ;; rest of the DGO load chain) is not decompiled yet, so kicking off the boot level load
      ;; would jump through an empty method slot. Flip *jakx-boot-level-load* in the REPL to
      ;; experiment with the load path.
      (when (and (nonzero? *level-load-list*) *jakx-boot-level-load*)
      (let ((s4-1 (level-get-for-use *level* s5-0 'active -1)))
        (let ((a1-11 (new 'stack-no-clear 'array 'symbol 18)))
          (set! (-> a1-11 17) #f)
          (set! (-> a1-11 16) #f)
          (set! (-> a1-11 15) #f)
          (set! (-> a1-11 14) #f)
          (set! (-> a1-11 13) #f)
          (set! (-> a1-11 12) #f)
          (set! (-> a1-11 11) #f)
          (set! (-> a1-11 10) #f)
          (set! (-> a1-11 9) #f)
          (set! (-> a1-11 8) #f)
          (set! (-> a1-11 7) #f)
          (set! (-> a1-11 6) #f)
          (set! (-> a1-11 5) #f)
          (set! (-> a1-11 4) #f)
          (set! (-> a1-11 3) #f)
          (set! (-> a1-11 2) #f)
          (set! (-> a1-11 1) (if (= s5-0 'ctysluma)
                                 'ctywide
                                 )
                )
          (set! (-> a1-11 0) s5-0)
          (want-levels *load-state* a1-11)
          )
        (want-display-level *load-state* s5-0 'display)
        (if (= s5-0 'ctysluma)
            (want-display-level *load-state* 'ctywide 'display)
            )
        (want-vis-level *load-state* s5-0)
        (while (and s4-1 (or (= (-> s4-1 status) 'loading) (= (-> s4-1 status) 'loading-bt) (= (-> s4-1 status) 'login)))
          (set-blackout-frames (seconds 0.02))
          (load-continue s4-1)
          )
        )
      )
      )
    (set! *print-login* #f)
    ;; og:preserve-this added #f check: level-get returns #f while level loading is not up yet
    ;; on the bring-up; the original assumes the boot level always exists.
    (let ((s4-2 (level-get *level* s5-0)))
      (if s4-2
          (level-status-update! s4-2 'active)
          )
      ;; og:preserve-this bring-up shim: the load-state update! method (which propagates
      ;; want -> target -> level display?) is not landed yet, so flip the level's
      ;; display? directly after boot activation. Retire with the update! landing.
      (if s4-2
          (set! (-> s4-2 display?) 'display)
          )
      ;; og:preserve-this bring-up shim: no camera/target start chain is landed, so the
      ;; free camera sits at the origin ~400 m from brdroom's geometry. Warp the camera
      ;; ring onto the level once at boot activation. Retire with the camera start chain.
      (if s4-2
          (jakx-cam-warp-to-level s4-2)
          )
      )
    )
  (on #t)
  ;; og:preserve-this temp disable: game-info.gc methods are not decompiled yet, so this
  ;; would jump through an empty method slot. Restore once game-info.gc lands.
  ;; (if arg1
  ;;     (initialize! *game-info* 'boot (the-as game-save #f) (the-as string #f) (the-as resetter-spec #f))
  ;;     )
  (kmemclose)
  (kmemclose)
  0
  )

;; definition for function play2
(defun play2 ((arg0 symbol) (arg1 symbol))
  (set! *use-menu2* #f)
  (play arg0 arg1)
  )

;; definition for function play-boot
;; WARN: Return type mismatch int vs none.
(defun play-boot ()
  (process-spawn-function
    process
    (lambda () (with-pp
                 (stack-size-set! (-> pp main-thread) 1024)
                 (play #t #t)
                 (none)
                 )
            )
    :name "play-boot"
    :from *4k-dead-pool*
    :stack *kernel-dram-stack*
    )
  0
  (none)
  )


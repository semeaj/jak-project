          )
      (dotimes (a2-0 6)
        (let ((a3-3 (-> this level a2-0)))
          (when (or (= (-> a3-3 status) 'active) (= (-> a3-3 status) 'reserved))
            (set! t0-5 (and (< (-> a3-3 draw-priority) f0-0) (begin
                                                               (dotimes (t0-6 (-> this draw-level-count))
                                                                 (when (= a3-3 (-> this draw-level t0-6))
                                                                   (set! t0-5 #f)

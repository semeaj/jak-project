              )
            )
          (vis-clear s1-0)
          (clear-mood-context (-> s1-0 mood-context))
          )
        )
      )
    (set! (-> gp-0 level-default vis-buffer) (the-as uint (malloc 'global 2048)))
    (set! (-> gp-0 level-default mood-context) (new 'global 'mood-context))
    (let ((a2-43 (if *debug-segment*
                     400
                     150
                     )
                 )
          )
      (set! (-> gp-0 level-default art-group) (new 'global 'load-dir-art-group a2-43 (-> gp-0 level-default)))
      )
    (dotimes (s5-1 19)
      (let ((s4-1 (-> gp-0 level s5-1)))
        (dotimes (v1-51 11)
          (set! (-> s4-1 texture-page-dir v1-51 page) #f)
          (set! (-> s4-1 texture-page-dir v1-51 link) #f)
          (set! (-> s4-1 texture-anim-array v1-51) #f)
          )
        (set! (-> s4-1 borrow-from-level) #f)
        (dotimes (v1-54 3)
          (set! (-> s4-1 borrow-level v1-54) #f)
          )
        (set! (-> s4-1 filter-num) (the-as uint 0))
        (when (and (>= s5-1 6) (>= 17 s5-1))
          (dotimes (s3-1 16)
            (set! (-> s4-1 filter-name s3-1) (new 'global 'string 64 (the-as string #f)))
            )
          )
        )
      )
    (set! (-> gp-0 level-default texture-anim-array 1) *default-pris-texture-anim-array*)
    (set! (-> gp-0 level-default texture-anim-array 3) *default-car-texture-anim-array*)
    (set! (-> gp-0 level-default texture-anim-array 4) *default-water-texture-anim-array*)
    (set! (-> gp-0 level-default texture-anim-array 8) *default-hud-texture-anim-array*)
    (set! (-> gp-0 level-default draw-priority) 20.0)
    (set! (-> gp-0 level-default info) default-level)
    (set! (-> *kernel-context* login-level-index) (-> gp-0 level-default index))
    ;; og:preserve-this bring-up: retail marks level-default 'reserved from the
    ;; loader (load-dir art-group load path; loader.o is a stub here). Without
    ;; it, assign-draw-indices leaves draw-level slot 18 empty and the
    ;; *texture-page-translate* walk never uploads the lcom tpages (the sky
    ;; textures page among them). Retire with the loader landing.
    (set! (-> gp-0 level-default status) 'reserved)
    (set! *default-level* (-> gp-0 level-default))
    (set! (-> gp-0 shared-ties) (new 'global 'prototype-node-group))
    )
  (kmemclose)
  )

;; og:preserve-this bring-up no-op: level-update (method 19) drives level transitions
;; per frame; the jakx body fails expression conversion. The boot level is already
;; 'loaded when the loop starts, so a no-op holds until the real port (hand-port from
;; jak3 level-update planned). The PC level-list push (jak3's og addition) runs so the
;; C++ loader learns which level fr3s to load and display.
(defmethod level-update ((this level-group))
  (let ((lev-names (new 'stack-no-clear 'array 'string 10))
        (active-lev-names (new 'stack-no-clear 'array 'string 10)))
    (dotimes (i 10)
      (set! (-> active-lev-names i) "none")
      (set! (-> lev-names i) "none")
      (cond
        ((or (= (-> this level i status) 'active)
             (= (-> this level i status) 'alive)
             (= (-> this level i status) 'loaded))
          (set! (-> lev-names i) (symbol->string (bsp-name (-> this level i))))
          (if (-> this level i display?)
              (set! (-> active-lev-names i) (-> lev-names i)))
          )
        )
      )
    (__pc-set-levels lev-names)
    (__pc-set-active-levels active-lev-names)
    )
  0
  (none)
  )
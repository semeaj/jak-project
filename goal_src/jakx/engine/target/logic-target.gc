(in-package goal)

;; name: logic-target.gc
;; name in dgo: logic-target
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

;; og:preserve-this bring-up stub: the real stop also kills the target process; no target
;; exists yet on the bring-up, so just record the mode like the original does.
(defun stop ((arg0 symbol))
  (set! (-> *game-info* mode) arg0)
  0
  )

;;-*-Lisp-*-
(in-package goal)

;; name: entity-more-perm.gc
;; name in dgo: entity-more-perm
;; dgos: ENGINE, GAME

;; DECOMP BEGINS

(deftype entity-more-perm (structure)
  ((aid         uint32     :offset-assert 0)
   (ent         basic      :offset-assert 4)
   (user-object object   2 :offset 8)
   (user-uint64 uint64     :offset 8)
   (user-float  float    2 :offset 8)
   (user-int32  int32    2 :offset 8)
   (user-uint32 uint32   2 :offset 8)
   (user-int16  int16    4 :offset 8)
   (user-uint16 uint16   4 :offset 8)
   (user-int8   int8     8 :offset 8)
   (user-uint8  uint8    8 :offset 8)
   )
  :method-count-assert 10
  :size-assert         #x10
  :flag-assert         #xa00000010
  (:methods
    (entity-more-perm-method-9 () none) ;; 9
    )
  )

(deftype entity-more-perm-hash (structure)
  ((data                entity-more-perm 512 :inline :offset-assert 0)
   (entity-more-perm-ct int32                :offset-assert 8192)
   (entity-indices      uint16 1024          :offset-assert 8196)
   )
  :method-count-assert 15
  :size-assert         #x2804
  :flag-assert         #xf00002804
  (:methods
    (entity-more-perm-hash-method-9 () none) ;; 9
    (entity-more-perm-hash-method-10 () none) ;; 10
    (entity-more-perm-hash-method-11 () none) ;; 11
    (entity-more-perm-hash-method-12 () none) ;; 12
    (entity-more-perm-hash-method-13 (_type_ level) none) ;; 13 ;; called method-of-type style from (method 25 level)
    (entity-more-perm-hash-method-14 (_type_ level) none) ;; 14 ;; called method-of-type style from (method 10 level) unload!
    )
  )

;; og:preserve-this hand-written from entity-more-perm_ir2.asm (methods 13/14 fail
;; expression building only on the dynamic-etype method dispatch, which type casts
;; cannot express). Both are class-method style: `this` is never read, and the
;; original callers pass *entity-more-perm* (still undefined = 0) in that slot.
;; Method 13 dispatches process-nettable method 32 on each nettable actor's etype;
;; method 14 is the byte-identical walk dispatching the adjacent slot 33.
(defmethod entity-more-perm-hash-method-13 ((this entity-more-perm-hash) (arg0 level))
  (when (and (-> arg0 name) (nonzero? (-> arg0 entity)) (-> arg0 entity))
    (dotimes (i (-> arg0 entity length))
      (let ((ent (-> arg0 entity data i entity)))
        (when (type? ent entity-actor)
          (let ((actor (the-as entity-actor ent)))
            (when (type-type? (-> actor etype) process-nettable)
              ;; og:preserve-this bring-up guard: an etype can be a landed deftype
              ;; skeleton deriving process-nettable whose slot 32 is still null (the
              ;; per-type actor code is unlanded); dispatching it was a call through
              ;; zero, found by the first streamed section's birth (jungleb; boot
              ;; levels' etypes are unresolved and skip the type-type? test entirely)
              (let ((t9-net (-> (-> actor etype) method-table (method-id-of-type process-nettable process-nettable-method-32))))
                (when (nonzero? (the-as int t9-net))
                  ((the-as (function process-nettable entity-actor none) t9-net)
                   (the-as process-nettable #f)
                   actor
                   )
                  )
                )
              )
            )
          )
        )
      )
    )
  0
  (none)
  )

(defmethod entity-more-perm-hash-method-14 ((this entity-more-perm-hash) (arg0 level))
  (when (and (-> arg0 name) (nonzero? (-> arg0 entity)) (-> arg0 entity))
    (dotimes (i (-> arg0 entity length))
      (let ((ent (-> arg0 entity data i entity)))
        (when (type? ent entity-actor)
          (let ((actor (the-as entity-actor ent)))
            (when (type-type? (-> actor etype) process-nettable)
              ;; og:preserve-this bring-up guard: same null-slot class as method 13's
              ;; slot 32 guard above, on the unload-side walk
              (let ((t9-net (-> (-> actor etype) method-table (method-id-of-type process-nettable process-nettable-method-33))))
                (when (nonzero? (the-as int t9-net))
                  ((the-as (function process-nettable entity-actor none) t9-net)
                   (the-as process-nettable #f)
                   actor
                   )
                  )
                )
              )
            )
          )
        )
      )
    )
  0
  (none)
  )



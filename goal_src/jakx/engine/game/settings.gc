;; og:preserve-this the top-level init landed nearly clean; the cam-settings default
;; block degrades to raw stores (s.f!/s.w!/s.d!/s.vf!), converted below to typed
;; pointer sets, op for op. *setting-control* gets its REAL init now (movie word #f,
;; video defaults, engine allocation via the hand new in settings-h).
(when (zero? *setting-control*)
  (kmemopen global "settings-struct")
  (set! *setting-control* (new 'global 'setting-control 64))
  (kmemclose)
  (let ((gp-0 (-> *setting-control* user-default))
        (s5-0 (-> *setting-control* user-current))
        )
    (let ((f0-1 (the float (scf-get-volume))))
      (set! (-> gp-0 unknown-usd-9) #f)
      (set! (-> gp-0 unknown-usd-8) (the-as basic #t))
      (set! (-> gp-0 weather) #t)
      (set! (-> gp-0 unknown-usd-13) #f)
      (set! (-> gp-0 unknown-usd-12) #f)
      (set! (-> gp-0 unknown-usd-14) #f)
      (set! (-> gp-0 unknown-usd-10) (the-as basic #t))
      (set! (-> gp-0 border-mode) #f)
      (set! (-> gp-0 unknown-usd-15) (the-as basic #t))
      (set! (-> gp-0 level-trans-time) 1500)
      (set! (-> gp-0 sfx-volume) (* 0.01000001 f0-1))
      (set! (-> gp-0 music-volume) (* 0.01000001 f0-1))
      (set! (-> gp-0 dialog-volume) (* 0.01000001 f0-1))
      (set! (-> gp-0 ambient-volume) (* 0.01000001 f0-1))
      (set! (-> gp-0 special-volume) (* 0.01000001 f0-1))
      (set! (-> gp-0 unknown-usd-736) (* 0.01000001 f0-1))
      (set! (-> gp-0 dynamic-ambient-volume) (* 0.0 f0-1))
      (set! (-> gp-0 sfx-volume-movie) (* 0.0 f0-1))
      (set! (-> gp-0 music-volume-movie) (* 0.0 f0-1))
      (set! (-> gp-0 ambient-volume-movie) (* 0.0 f0-1))
      (set! (-> gp-0 dialog-volume-talker) (* 0.01000001 f0-1))
      (set! (-> gp-0 talker-volume) (* 0.009500009 f0-1))
      )
    (set! (-> gp-0 unknown-usd-16) (the-as basic (the-as uint #x80f0f0f0)))
    (set! (-> gp-0 unknown-usd-17) (the-as basic (the-as uint #x80f0f0f0)))
    (set! (-> gp-0 task-mask) (task-mask vehicle ctywide never))
    (set! (-> gp-0 task-manager) (the-as (pointer process) #f))
    (set! (-> gp-0 task) #f)
    (set! (-> gp-0 exclusive-task-count) (the-as uint 0))
    (set! (-> gp-0 exclusive-load) (the-as symbol '()))
    (set! (-> gp-0 minimap) (the-as uint 18))
    (set! (-> gp-0 race-minimap) 0)
    (set! (-> gp-0 language) (the-as language-enum (scf-get-language)))
    (set! (-> gp-0 subtitle-language) (the-as uint (-> gp-0 language)))
    (let ((v1-24 (-> gp-0 language)))

;; definition for method 13 of type setting-control
;; WARN: Return type mismatch connection vs none.
(defmethod setting-control-method-13 ((this setting-control) (arg0 engine-pers) (arg1 object) (arg2 object) (arg3 object) (arg4 object))
  (add-connection (-> this engine) (the-as process arg0) arg1 arg2 arg3 arg4)
  (none)
  )

;; definition for method 15 of type setting-control
;; WARN: Return type mismatch connection vs connectable.
(defmethod setting-control-method-15 ((this setting-control) (arg0 object) (arg1 object) (arg2 object) (arg3 object) (arg4 object))
  (let ((s4-0 arg2)
        (s3-0 arg3)
        (s2-0 arg4)
        )
    (setting-control-method-16 this (the-as process arg0) arg1 arg2)
    (the-as connectable (add-connection (-> this engine) (the-as process arg0) arg1 s4-0 s3-0 s2-0))
    )
  )

;; definition for method 14 of type setting-control
;; WARN: Return type mismatch int vs none.
(defmethod setting-control-method-14 ((this setting-control) (arg0 symbol) (arg1 int) (arg2 symbol) (arg3 symbol) (arg4 float) (arg5 int))
  (let ((v1-1 (schedule-callback (-> this engine-pers) arg0 (the-as time-frame arg1))))
    (when v1-1
      (set! (-> v1-1 param 0) arg2)
      (set! (-> v1-1 param 1) arg3)
      (set! (-> v1-1 param 2) arg4)
      (set! (-> v1-1 param 3) arg5)
      )
    )
  0
  (none)
  )

;; definition for method 16 of type setting-control
;; WARN: Return type mismatch int vs none.
(defmethod setting-control-method-16 ((this setting-control) (arg0 process) (arg1 object) (arg2 object))
  (when arg0
    (let ((s5-0 (-> this engine))
          (s4-0 (-> arg0 connection-list next1))
          )
      (while (the-as connection s4-0)
        (if (and ((method-of-type connection belongs-to-engine?) (the-as connection s4-0) s5-0)
                 (or (= arg1 #t) (= arg1 (-> (the-as connection s4-0) param0)))
                 )
            (move-to-dead (the-as connection s4-0))
            )
        (set! s4-0 (-> (the-as connection s4-0) next1))
        )
      )
    )
  0
  (none)
  )

;; definition for method 19 of type setting-control
;; WARN: Return type mismatch int vs user-setting-data.
(defmethod setting-control-method-19 ((this setting-control) (arg0 object))
  (if arg0
      ((method-of-type connection move-to-dead) (the-as connection arg0))
      )
  (the-as user-setting-data 0)
  )

;; og:preserve-this hand-written: settings has two identical anonymous kill-matching
;; predicates (anon-function 6 and 13, labels L120/L137) that match a persistent
;; connection by key and first param; the decompiler cannot type anonymous functions,
;; so they land as one shared named helper.
(defun settings-persist-match? ((arg0 engine-pers) (arg1 connection-pers) (arg2 object) (arg3 object))
  (and (= (-> arg1 key) arg2) (= (-> arg1 param 0) arg3))
  )

;; definition for method 17 of type setting-control
;; WARN: Return type mismatch int vs connection.
(defmethod setting-control-method-17 ((this setting-control) (arg0 symbol) (arg1 object) (arg2 object) (arg3 object))
  (kill-matching
    (-> this engine-pers)
    (the-as (function engine-pers connection-pers object object symbol) settings-persist-match?)
    arg0
    arg1
    )
  (the-as connection 0)
  )

;; definition for method 20 of type setting-control
(defmethod setting-control-method-20 ((this setting-control) (arg0 object))
  (let ((v1-1 (-> this engine-hi alive-list next0)))
    (-> this engine-hi)
    (let ((a2-2 (-> (the-as connection v1-1) next0)))
      (while (!= (the-as connection v1-1) (-> this engine-hi alive-list-end))
        (if (= (-> (the-as connection v1-1) param0) arg0)
            (return (the-as connection v1-1))
            )
        (set! v1-1 a2-2)
        (-> this engine-hi)
        (set! a2-2 (-> a2-2 next0))
        )
      )
    )
  (the-as connection #f)
  )

;; definition for method 21 of type setting-control
;; WARN: Return type mismatch int vs none.
(defmethod setting-control-method-21 ((this setting-control) (arg0 object))
  (remove-by-param0 (-> this engine-hi) arg0)
  0
  (none)
  )

;; definition for method 22 of type setting-control
;; WARN: Return type mismatch connection vs none.
(defmethod setting-control-method-22 ((this setting-control) (arg0 object) (arg1 object) (arg2 object) (arg3 object))
  (remove-by-param0 (-> this engine-hi) arg0)
  (add-connection (-> this engine-hi) *dproc* arg0 arg1 arg2 arg3)
  (none)
  )


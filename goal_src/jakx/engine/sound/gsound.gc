;; definition for symbol *debug-sound-info-item*, type basic
(define *debug-sound-info-item* (the-as basic #f))

;; definition for function sound-instance-play
;; INFO: Used lq/sq
;; WARN: Return type mismatch uint vs sound-id.
(defun sound-instance-play ((inst sound-instance))
  (when (-> inst info)
    (when *sound-player-enable*
      (let ((s5-0 (the-as sound-rpc-play (get-sound-buffer-entry))))
        (set! (-> s5-0 command) (the-as uint 4))
        (set! (-> s5-0 id) (the-as sound-id (-> inst id)))
        (set! (-> s5-0 name) (-> inst info name))
        (set! (-> inst group) (-> inst info group))
        (quad-copy! (the-as pointer (-> s5-0 params)) (the-as pointer inst) 1)
        (set! (-> s5-0 params volume) (max 0 (min 1024 (the int (* (the float (-> inst volume)) (-> inst volumef))))))
        )
      (logand! (-> inst flags) -65)
      )
    )
  (the-as sound-id (-> inst id))
  )

;; definition for function sound-instance-update
;; WARN: Return type mismatch uint vs sound-id.
(defun sound-instance-update ((inst sound-instance))
  (when (or *sound-player-enable* (logtest? (-> inst flags) 128))
    (let ((s5-0 (the-as sound-rpc-set-param (get-sound-buffer-entry))))
      (set! (-> s5-0 command) (the-as uint 8))
      (set! (-> s5-0 id) (the-as sound-id (-> inst id)))
      (set! (-> inst group) (-> inst info group))
      (quad-copy! (the-as pointer (-> s5-0 params)) (the-as pointer inst) 3)
      (set! (-> s5-0 params volume) (max 0 (min 1024 (the int (* (the float (-> inst volume)) (-> inst volumef))))))
      (logand! (-> inst flags) -65)
      (when (and *debug-sound-info-item* (the-as basic #f))
        (if (= (-> inst info index) *debug-sound-info-item*)
            (format #t "~D ~D~%" (-> s5-0 params group) (-> s5-0 params volume))
            )
        )
      )
    )
  (the-as sound-id (-> inst id))
  )

;; definition for function sound-info-by-name

                        )
                      )
                    )
               (set! (-> s3-0 fader-targ) 1.1)
               (set! (-> s3-0 fader-targ) 1.0)
               )
           )
          (else
            (set! (-> s3-0 fader-targ) 1.0)
            )
          )
        (seek! (-> s3-0 fader-cur) (-> s3-0 fader-targ) (* 10.0 (seconds-per-frame)))
        (+! s4-0 1)
        (set! s3-0 (-> gp-0 s4-0))
        )
      )
    (if (and *stats-sound* (not (paused?)))
        (format *stdebug* "~0K~Name~130HID~+50HVol~+15HPitch~+24HPan~+18HEar~+24HDist~%")
        )
    (let ((s5-1 *sound-priority-level*)
          (f30-0 *sound-duck-amount*)
          (gp-1 #f)
          )
      (set! *sound-priority-level* 0)
      (set! *sound-duck-amount* 0.0)
      (dotimes (s4-1 (-> *sound-instances* length))
        (let* ((s3-1 (-> *sound-instances* s4-1))
               (s0-0 (-> s3-1 info))
               (s2-0 (-> s3-1 volume))
               (f28-0 (-> s3-1 volumef))
               (s1-0 (-> s3-1 pitch-mod))
               )
          (when (zero? s0-0)
            (set! s0-0 (-> *sound-info* (-> s3-1 info-index)))
            (set! (-> s3-1 info) s0-0)
            )
          (when *debug-sound-info-item*
            (when (= (-> s0-0 index) *debug-sound-info-item*)
              (nop!)
              (nop!)
              0
              )
            )
          (set! (-> s3-1 volumef) (* (-> s3-1 volumef) (-> s3-1 sh fader-cur)))
          (if (< (-> s0-0 priority) s5-1)
              (set! (-> s3-1 volumef) (* (-> s3-1 volumef) (- 1.0 f30-0)))
              )
          (if (and (or (< *target-time-speed* 0.01)
                       (or (and (< *target-time-speed* 1.0) (not (logtest? (-> s0-0 flags) 192)))
                           (and (-> *setting-control* user-current unknown-usd-768) (not (logtest? (-> s0-0 flags) 256)))
                           )
                       )
                   (!= (-> s0-0 group) 14)
                   )
              (set! (-> s3-1 volumef) 0.0)
              )
          (when (or (= (-> s3-1 volumef) 0.0) (zero? (-> s3-1 volume)))
            (sound-stop (the-as sound-id (-> s3-1 id)) #f)
            (remove-sound-instance-by-index s4-1)
            (+! s4-1 -1)
            (goto cfg-154)
            )
          (when (or (nonzero? (-> s3-1 last-update)) (not (logtest? (-> s3-1 flags) 64)))
            (dotimes (v1-79 48)
              (when (= (-> s3-1 id) (-> *sound-iop-info* id-info v1-79))
                (set! (-> s3-1 last-update) (the-as uint (current-time)))
                (logior! (-> s3-1 flags) 64)
                #t
                (goto cfg-73)
                )
              )
            (label cfg-73)
            (cond
              ((= (-> s0-0 group) 14)
               (when (>= (- (-> *display* real-clock frame-counter) (the-as int (-> s3-1 last-update))) (seconds 0.167))
                 (remove-sound-instance-by-index s4-1)
                 (+! s4-1 -1)

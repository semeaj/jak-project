                 (+! (-> *sound-instances* length) 1)
                 (+! (-> info num-instances) 1)
                 )
               (else
                 (format 0 "ERROR: could not allocate a sound-handle~%")
                 (return (the-as sound-instance #f))
                 )
               )
             )
            (else

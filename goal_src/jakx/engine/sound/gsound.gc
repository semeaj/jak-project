              (else
                (when (time-elapsed? (the-as int (-> s3-1 last-update)) (seconds 0.167))
                  (remove-sound-instance-by-index s4-1)
                  (+! s4-1 -1)
                  (goto cfg-154)
                  )
                )
              )
            )
          (when (and (< *target-time-speed* 1.0) (not (logtest? (-> s0-0 flags) 128)) (!= (-> s0-0 group) 14))
            (let* ((f0-19 (* 0.000656168 (the float s1-0)))
                   (f1-10 (fabs f0-19))
                   )
              (if (= f1-10 0.0)
                  (set! f1-10 0.33)
                  )
              (let ((f0-20 (- f0-19 (* 0.5 (- 1.0 *target-time-speed*) f1-10))))
                (set! (-> s3-1 pitch-mod) (the int (* 1524.0 f0-20)))
                )
              )
            (logior! (-> s3-1 mask) 1)
            )
          (when (and (or (not (paused?)) (= (-> s0-0 group) 14)) (logtest? (-> s3-1 flags) 192))
            (cond
              ((or (logtest? (-> s3-1 flags) 256) (and (not (logtest? (-> s0-0 flags) 1024))
                                                       (= (logand (-> s3-1 sh flags) 3) 3)
                                                       (zero? (-> *viewport-array* mode))
                                                       )
                   )
               (set! (-> s3-1 volumef) (* (-> s3-1 volumef) (-> s0-0 volume)))
               (set! (-> s3-1 pan) (the int (-> s0-0 pan)))
               )
              (else

        (cond
          ((logtest? (-> s3-0 flags) 1)
           (if (and (zero? (-> *viewport-array* mode))
                    (cond
                      ((send-event (handle->process (-> s3-0 proc)) 'query 'camera-inside-view)
                       (logior! (-> s3-0 flags) 2)
                       #t
                       )
                      (else
                        (logand! (-> s3-0 flags) -3)

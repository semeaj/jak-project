                        (and (= (-> s0-0 priority) *sound-priority-level*)
                             (and (< *sound-duck-amount* (-> s0-0 duck-amount))
                                  (or (not (logtest? (-> s0-0 flags) 4096)) (logtest? (-> s3-1 sh flags) 1))
                                  )
                             )
                        )
                (set! *sound-priority-level* (-> s0-0 priority))
                (set! *sound-duck-amount* (-> s0-0 duck-amount))
                )
              (if (and (logtest? (-> s0-0 flags) 2048)
                       (or (not (logtest? (-> s0-0 flags) 4096)) (logtest? (-> s3-1 sh flags) 1))
                       )
                  (set! gp-1 #t)
                  )

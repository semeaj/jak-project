;; definition for function get-sound-handle
(defun get-sound-handle ((owner handle))
  (with-pp
    (let ((s4-0 0))
      (if (or (type? pp vehicle) (and owner (let ((a0-2 (-> owner process 0)))
                                              (type? a0-2 vehicle)
                                              )
                                      )
              )
          (set! s4-0 1)
          )
      (let ((s3-0 (-> *sound-handles* s4-0)))
        (set! owner (cond
                      (owner
                        (empty)
                        owner
                        )
                      (else
                        (process->handle pp)
                        )
                      )
              )
        (let ((s5-0 (find-sound-handle s4-0 owner)))
          (when (not s5-0)
            (when (< (-> s3-0 length) (-> s3-0 allocated-length))
              (set! s5-0 (-> s3-0 (-> s3-0 length)))
              (set! (-> s5-0 fader-cur) 1.0)
              (set! (-> s5-0 fader-targ) 1.0)
              (+! (-> s3-0 length) 1)
              )
            )
          (when s5-0
            (when (= s4-0 1)
              (let ((v1-25 (as-type (handle->process owner) process-focusable)))
                (when v1-25
                  (if (focus-test? (the-as process-focusable v1-25) unk-35)
                      (logior! (-> s5-0 flags) 1)
                      )
                  )
                )
              )
            (set! (-> s5-0 proc) owner)
            (+! (-> s5-0 num-instances) 1)
            )
          s5-0
          )
        )
      )
    )
  )


;; definition for function calculate-pan-angle
(defun calculate-pan-angle ((trans vector) (use-world-axes symbol) (allow-flip symbol) (arg3 symbol) (viewport int))
  (let* ((a2-1 (-> (view-get-math-camera viewport) inv-camera-rot))
         (a0-2 (new 'stack-no-clear 'vector))
         (a1-1 (-> a2-1 rvec))
         (v1-0 (-> a2-1 fvec))
         )
    0.0
    0.0
    0.0
    (cond
      (use-world-axes
        (set! v1-0 *z-vector*)
        (set! a1-1 *x-vector*)
        )
      (else
        (vector-! a0-2 trans (-> a2-1 trans))
        )
      )
    (let* ((f0-5 (- (vector-dot a0-2 a1-1)))
           (f1-1 (vector-dot a0-2 v1-0))
           (angle (atan f0-5 f1-1))
           )
      (if (< angle 0.0)
          (set! angle (+ 65536.0 angle))
          )
      (if (and allow-flip (logtest? (-> *game-info* secrets) #x4000))
          (set! angle (- 65536.0 angle))
          )
      (if (>= angle 65536.0)
          (set! angle (the-as float 0.0))
          )
      angle
      )
    )
  )

;; definition for function update-pan-angle
(defun update-pan-angle ((inst sound-instance) (allow-flip symbol))

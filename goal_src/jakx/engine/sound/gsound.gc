;; definition for function calculate-falloff-volume
;; INFO: Used lq/sq
(defun calculate-falloff-volume ((volume float)
                        (trans vector)
                        (fo-power float)
                        (fo-min float)
                        (fo-max float)
                        (ear-pos vector)
                        (inst sound-instance)
                        )
  (let ((v1-0 (new 'stack-no-clear 'vector)))
    0.0
    (set! (-> v1-0 quad) (-> trans quad))
    (vector-! v1-0 ear-pos v1-0)
    (let ((f0-1 (vector-length v1-0)))
      (if (and *stats-sound* inst)
          (set! (-> inst sh dist) f0-1)
          )
      (if (or (>= fo-min f0-1) (= fo-power 0.0))
          (return volume)
          )
      (if (>= f0-1 fo-max)
          (return 0.0)
          )
      (let ((f0-2 (lerp-scale 0.0 1.0 f0-1 fo-min fo-max)))
        (* volume (- 1.0 (pow f0-2 fo-power)))
        )
      )
    )
  )

;; definition for function update-volume-with-falloff
(defun update-volume-with-falloff ((inst sound-instance))
  (local-vars (s3-0 vector) (s4-0 vector))
  (let ((s5-0 (-> inst info))
        (f30-0 (-> inst volumef))
        )
    (let ((f28-0 (-> s5-0 fo-power))
          (f26-0 (-> s5-0 fo-min))
          (f24-0 (-> s5-0 fo-max))
          )
      (if (logtest? (-> s5-0 flags) 4)
          (set! s4-0 (ear-trans 1 0))
          (set! s4-0 (ear-trans 0 0))
          )
      (if (logtest? (-> inst flags) 8)
          (set! f28-0 (-> inst fo-power))
          )
      (if (logtest? (-> inst flags) 2)
          (set! f26-0 (-> inst fo-min))
          )
      (if (logtest? (-> inst flags) 4)
          (set! f24-0 (-> inst fo-max))
          )
      (if (!= (-> s5-0 fo-power) 0.0)
          (set! f30-0 (calculate-falloff-volume f30-0 (-> inst trans) f28-0 f26-0 f24-0 s4-0 inst))
          )
      (when (nonzero? (-> *viewport-array* mode))
        (let ((f22-0 (-> inst volumef)))
          (if (logtest? (-> s5-0 flags) 4)
              (set! s3-0 (ear-trans 1 1))
              (set! s3-0 (ear-trans 0 1))
              )
          (if (!= (-> s5-0 fo-power) 0.0)
              (set! f22-0 (calculate-falloff-volume f22-0 (-> inst trans) f28-0 f26-0 f24-0 s3-0 inst))
              )

(define *sound-bank-reload-names*
  (the-as (array symbol) (new 'static 'boxed-array :type symbol :length 7 :allocated-length 7))
  )

;; definition for function sound-bank-reload
;; WARN: Return type mismatch int vs none.
(defun sound-bank-reload ()
  (process-spawn-function
    process
    (lambda ()
      (let ((gp-0 *sound-bank-reload-names*))
        (dotimes (v1-0 7)
          (set! (-> gp-0 v1-0) (-> *level* sound-bank v1-0 name))
          )
        (let ((a1-3 (new 'stack-no-clear 'array 'symbol 4)))
          (set! (-> a1-3 0) 'empty0)
          (want-sound-banks *load-state* a1-3)
          )
        (suspend-for (seconds 1)
          )
        (let ((a1-4 (new 'stack-no-clear 'array 'symbol 4)))
          (set! (-> a1-4 0) (-> gp-0 0))
          (want-sound-banks *load-state* a1-4)
          )
        )
      (none)
      )
    :to *display-pool*
    )
  0
  (none)
  )

;; definition for function sound-bank-reload-common

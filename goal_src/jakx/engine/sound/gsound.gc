    (s5-0 *temp-string* arg0 32 144 (font-color default) (font-flags shadow))
    )
  (let ((s5-1 draw-string-xy))
    (format (clear *temp-string*) "max: ~8D bytes" (-> *sound-iop-info* freemem))
    (s5-1 *temp-string* arg0 32 160 (font-color default) (font-flags shadow))
    )
  0
  )

;; definition for function ear-trans
(defun ear-trans ((mode int) (view-idx int))
  (cond
    ((= mode 1)
     ;; og:preserve-this runtime-link guard: get-player-pos's home (net-player.o) is an
     ;; empty stub, so the symbol reads 0 -- and the flags-4 sound-info records (the
     ;; jungle water ambience: wtrfall-*, waves-amb, cave-drips, 69 records) route here
     ;; through update-volume-with-falloff the first frame their instance updates, which
     ;; is what crashed every ring flight at jungle-b's birth. Fall back to the camera
     ;; ear (the mode-0 default) until net-player lands; drop the guard then.
     (if (nonzero? get-player-pos)
         (get-player-pos view-idx)
         (math-camera-pos)
         )
     )
    ((or (movie?) *external-cam-mode*)
     (math-camera-pos)
     )
    (else
      (-> (view-get-math-camera view-idx) trans)
      )
    )
  )


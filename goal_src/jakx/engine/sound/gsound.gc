(defun current-str-status ((arg0 sound-id))
  (dotimes (v1-0 4)
    (if (= arg0 (-> *sound-iop-info* stream-id v1-0))
        (return (the-as stream-status (-> *sound-iop-info* stream-status v1-0)))
        )
    )
  (the-as stream-status 0)
  )

;; definition for symbol *dnas-is-running*, type symbol

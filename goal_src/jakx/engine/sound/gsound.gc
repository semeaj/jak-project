;; definition for function sound-info-by-name
;; INFO: Used lq/sq
(defun sound-info-by-name ((arg0 string))
  (when (and (nonzero? arg0) arg0)
    (dotimes (s5-0 (-> *sound-info* length))
      (let ((s4-0 (-> *sound-info* s5-0)))
        (when (sound-name= (the-as sound-name (-> s4-0 name)) (the-as sound-name arg0))
          (if (zero? s5-0)
              (return (the-as sound-info #f))
              )
          (return s4-0)
          )
        )
      )
    (format 0 "ERROR: couldn't find SOUND '~S' in *sound-info*~%" (sound-name->string (the-as sound-name arg0)))
    )
  (the-as sound-info #f)
  )

;; definition for symbol *sound-handles*, type (array array)
;; og:preserve-this hand-rewritten from the degraded top-level: the original is a
;; static 2-slot (array array) (label L383); slot 0 holds 128 game sound-handles
;; (svc 0), slot 1 holds 12 service handles (svc 1), each handle stamped with its index.
(define *sound-handles* (the-as (array array) (new 'static 'boxed-array :type array :length 2 :allocated-length 2)))

(set! (-> *sound-handles* 0) (the-as array (new 'global 'boxed-array sound-handle 128)))
(set! (-> *sound-handles* 0 length) 0)
(let ((s0 (the-as (array sound-handle) (-> *sound-handles* 0))))
  (dotimes (gp-0 128)
    (let ((h (new 'global 'sound-handle)))
      (set! (-> s0 gp-0) h)
      (set! (-> h index) gp-0)
      (set! (-> h svc) 0)
      )
    )
  )

(set! (-> *sound-handles* 1) (the-as array (new 'global 'boxed-array sound-handle 12)))
(set! (-> *sound-handles* 1 length) 0)
(let ((s1 (the-as (array sound-handle) (-> *sound-handles* 1))))
  (dotimes (gp-1 12)
    (let ((h (new 'global 'sound-handle)))
      (set! (-> s1 gp-1) h)
      (set! (-> h index) gp-1)
      (set! (-> h svc) 1)
      )
    )
  )


(define *last-music-position* (the-as uint 0))

;; definition for function jukebox-onoff
;; WARN: Return type mismatch int vs symbol.
(defun jukebox-onoff ((arg0 symbol))
  (when (not arg0)
    (set! *last-music-position* (the-as uint -1))
    (setting-control-method-15 *setting-control* *dproc* 'music #f 0 0)
    )
  (if arg0
      (set! *jukebox-time* (the-as int (-> *display* game-clock frame-counter)))
      )
  (set! *jukebox-onoff* arg0)
  (the-as symbol 0)
  )

;; definition for function update-jukebox-music
;; WARN: Return type mismatch int vs none.
(defun update-jukebox-music ()
  (with-pp
    (cond
      ((and *jukebox-onoff* (not (-> *setting-control* user-current unknown-usd-752)))
       (when (< *jukebox-time* (-> *display* game-clock frame-counter))
         (set! *jukebox-time* (the-as int (+ (-> *display* game-clock frame-counter) (seconds 5))))
         (cond
           ((or (zero? (-> *sound-iop-info* music-name name 0))
                (and (not (paused?))
                     (not *music-lock*)
                     (or (= (-> *sound-iop-info* music-position) *last-music-position*)
                         (>= (* 0.0009765625 (the float (- (-> *sound-iop-info* music-position) *last-music-position*))) 20.0)
                         )
                     )
                )
            (let ((v1-23 (mod (-> *game-info* jukebox-track) (the-as uint 21))))
              (cond
                ((zero? v1-23)
                 (setting-control-method-15 *setting-control* pp 'music 'angle 0 0)
                 )
                ((= v1-23 1)
                 (setting-control-method-15 *setting-control* pp 'music 'ass 0 0)
                 )
                ((= v1-23 2)
                 (setting-control-method-15 *setting-control* pp 'music 'bird 0 0)
                 )
                ((= v1-23 3)
                 (setting-control-method-15 *setting-control* pp 'music 'boris 0 0)
                 )
                ((= v1-23 4)
                 (setting-control-method-15 *setting-control* pp 'music 'crisis 0 0)
                 )
                ((= v1-23 5)
                 (setting-control-method-15 *setting-control* pp 'music 'fracture 0 0)
                 )
                ((= v1-23 6)
                 (setting-control-method-15 *setting-control* pp 'music 'frozen 0 0)
                 )
                ((= v1-23 7)
                 (setting-control-method-15 *setting-control* pp 'music 'bondo 0 0)
                 )
                ((= v1-23 8)
                 (setting-control-method-15 *setting-control* pp 'music 'harsh 0 0)
                 )
                ((= v1-23 9)
                 (setting-control-method-15 *setting-control* pp 'music 'heli 0 0)
                 )
                ((= v1-23 10)
                 (setting-control-method-15 *setting-control* pp 'music 'run 0 0)
                 )
                ((= v1-23 11)
                 (setting-control-method-15 *setting-control* pp 'music 'secondi 0 0)
                 )
                ((= v1-23 12)
                 (setting-control-method-15 *setting-control* pp 'music 'silver 0 0)
                 )
                ((= v1-23 13)
                 (setting-control-method-15 *setting-control* pp 'music 'tempest 0 0)
                 )
                ((= v1-23 14)
                 (setting-control-method-15 *setting-control* pp 'music 'theater 0 0)
                 )
                ((= v1-23 15)
                 (setting-control-method-15 *setting-control* pp 'music 'touch 0 0)
                 )
                ((= v1-23 16)
                 (setting-control-method-15 *setting-control* pp 'music 'trintite 0 0)
                 )
                ((= v1-23 17)
                 (setting-control-method-15 *setting-control* pp 'music 'bondo 0 0)
                 )
                ((= v1-23 18)
                 (setting-control-method-15 *setting-control* pp 'music 'aftertch 0 0)
                 )
                ((= v1-23 19)
                 (setting-control-method-15 *setting-control* pp 'music 'flat 0 0)
                 )
                ((= v1-23 20)
                 (setting-control-method-15 *setting-control* pp 'music 'reborn 0 0)
                 )
                )
              )
            (+! (-> *game-info* jukebox-track) 1)
            (set! *last-music-position* (the-as uint -1))
            )
           (else
             (set! *last-music-position* (-> *sound-iop-info* music-position))
             )
           )
         )
       )
      (else
        )

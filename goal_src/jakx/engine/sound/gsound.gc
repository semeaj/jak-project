        (return f0-3)
        )
      )
    0.0
    (let ((f30-0
            (calculate-pan-angle (-> inst trans) (logtest? (-> s4-0 flags) 2) allow-flip (logtest? (-> s4-0 flags) 4) 0)
            )
          )
      (cond
        ((zero? (-> *viewport-array* mode))
         (set! (-> inst pan-angle) f30-0)
         )
        (else
          0.0
          (let ((f28-0 (vector-vector-distance (-> inst trans) (ear-trans 0 0)))
                (f26-0 (vector-vector-distance (-> inst trans) (ear-trans 0 1)))
                (f0-6
                  (calculate-pan-angle (-> inst trans) (logtest? (-> s4-0 flags) 2) allow-flip (logtest? (-> s4-0 flags) 4) 1)
                  )
                )
            (cond
              ((and (< f28-0 1638400.0) (< f26-0 1638400.0))
               (let* ((f0-10 (+ f30-0 (* 0.5 (fabs (- f30-0 f0-6)))))
                      (f0-11 (- f0-10 (* (the float (the int (/ f0-10 65536.0))) 65536.0)))
                      )
                 (if (zero? (-> inst last-update))
                     (set! (-> inst pan-angle) f0-11)
                     (seek! (-> inst pan-angle) f0-11 (* 16384.0 (seconds-per-frame)))
                     )
                 )
               )
              ((< f26-0 f28-0)
               (set! (-> inst pan-angle) f0-6)
               )
              )
            )
          )
        )
      )
    )
  (-> inst pan-angle)

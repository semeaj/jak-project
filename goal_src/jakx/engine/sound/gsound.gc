        (mem-clear! (the-as pointer s3-0) 92)
        (set! (-> s3-0 sh) s2-0)
        (set! (-> s3-0 last-update) (the-as uint s4-0))
        (set! (-> s3-0 pan-angle) f30-0)
        )
      (set! (-> s3-0 info) info)
      (if (zero? id)
          (set! id (new-sound-id))
          )
      (set! (-> s3-0 id) (the-as uint id))
      (set! (-> s3-0 volume) 1024)
      (set! (-> s3-0 volumef) 1.0)
      (logior! (-> s3-0 flags) 64)
      (return s3-0)

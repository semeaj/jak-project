          (set! (-> s3-1 volumef) f28-0)
          (set! (-> s3-1 pitch-mod) s1-0)
          )
        (label cfg-154)
        )
      (when (>= *target-time-speed* 1.0)
        (cond
          (gp-1
            (when (< *music-volume-ducked-by-sound* (-> *setting-control* user-target music-volume))
              (setting-control-method-15 *setting-control* pp 'music-volume 'rel *music-volume-ducked-by-sound* 0)
              (set! *music-ducked-last-frame?* #t)
              )
            )
          (*music-ducked-last-frame?*
            (setting-control-method-16 *setting-control* pp 'music-volume)
            (set! *music-ducked-last-frame?* #f)
            )
          )
        )
      )
    (when *debug-sound-sliders*
      (format *stdebug* "sfx-volume=~220h~f~%" *settings-sfx-volume*)
      (format *stdebug* "music-volume=~220h~f~%" *settings-music-volume*)
      (format *stdebug* "dialog-volume=~220h~f~%" *settings-dialog-volume*)
      (format *stdebug* "music-volume-during-speech=~220h~f~%" *music-volume-during-speech*)

      (set! (-> v1-1 command) (the-as uint 0))
      (set! (-> v1-1 bank-name) arg0)
      (set! (-> v1-1 mode) (the-as uint arg1))
      (set! (-> v1-1 priority) (the-as uint arg2))
      )
    (call *sound-loader-rpc* (the-as uint 0) (the-as pointer 0) (the-as uint 0))
    gp-0
    )
  )


                (update-volume-with-falloff s3-1)
                (when (!= (-> s3-1 volumef) 0.0)
                  (if (logtest? (-> s0-0 flags) 32)
                      (update-pitch-with-doppler s3-1)
                      )
                  (set! (-> s3-1 pan) (the int (* 0.005493164 (update-pan-angle s3-1 #t))))
                  )
                )
              )
            (when (!= (-> s3-1 volumef) 0.0)

;; definition for function sound-command->string
(defun sound-command->string ((arg0 uint))
  (let ((v1-0 arg0))
    (cond
      ((= v1-0 16)
       "shutdown"
       )
      ((= v1-0 14)
       "set-language"
       )
      ((= v1-0 13)
       "get-irx-version"
       )
      ((= v1-0 11)
       "stop-group"
       )
      ((= v1-0 8)
       "set-param"
       )
      ((= v1-0 4)
       "play"
       )
      ((= v1-0 12)
       "continue-group"
       )
      ((= v1-0 21)
       "set-stereo-mode"
       )
      ((= v1-0 2)
       "load-music"
       )
      ((= v1-0 7)
       "continue-sound"
       )
      ((= v1-0 3)
       "unload-music"
       )
      ((= v1-0 15)
       "set-reverb"
       )
      ((= v1-0 22)
       "set-globals"
       )
      ((= v1-0 20)
       "cancel-dgo"
       )
      ((= v1-0 6)
       "stop-sound"
       )
      ((= v1-0 5)
       "pause-sound"
       )
      ((zero? v1-0)
       "load-bank"
       )
      ((= v1-0 18)
       "set-fps"
       )
      ((= v1-0 1)
       "unload-bank"
       )
      ((= v1-0 17)
       "list-sounds"
       )
      ((= v1-0 9)
       "set-master-volume"
       )
      ((= v1-0 19)
       "iop-mem"
       )
      ((= v1-0 10)
       "pause-group"
       )
      (else
        "*unknown*"
        )
      )
    )
  )

;; definition for function sound-buffer-dump
(defun sound-buffer-dump ()
  (let ((gp-0 (-> *sound-player-rpc* current elt-used))
        (s5-0 (-> *sound-player-rpc* current elt-size))
        )
    (dotimes (s4-0 (the-as int gp-0))
      (let* ((s3-0 (the-as sound-rpc-play (&+ (-> *sound-player-rpc* current base) (* s5-0 (the-as uint s4-0)))))
             (a3-0 (sound-command->string (-> s3-0 command)))
             )
        (case (-> s3-0 command)
          ((4)
           (format #t "~D ~A ~G~%" s4-0 a3-0 (&-> s3-0 name))
           )
          (else
            (format #t "~D ~A~%" s4-0 a3-0)
            )
          )
        )
      )
    )
  0
  )

